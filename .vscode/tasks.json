{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build file-manager-api",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\file-manager-api\\file-manager-api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build file-manager-blazor",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\file-manager-blazor\\FileManagerBlazor.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "kill file-manager-blazor port 5167",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\kill-port.ps1",
        "-Port",
        "5167"
      ],
      "problemMatcher": []
    },
    {
      "label": "stop existing file-manager-blazor instances",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Stop-FileManagerDevProcesses.ps1",
        "-Ports",
        "5167",
        "7016",
        "-CommandLinePatterns",
        "FileManagerBlazor",
        "file-manager-blazor",
        "blazor-devserver"
      ],
      "problemMatcher": []
    },
    {
      "label": "stop existing file-manager-api instances",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Stop-FileManagerDevProcesses.ps1",
        "-Ports",
        "5268",
        "-CommandLinePatterns",
        "file-manager-api",
        "file-manager-api\\.dll"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare launch file-manager-api",
      "dependsOn": [
        "stop existing file-manager-api instances",
        "build file-manager-api"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "run file-manager-api",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\file-manager-api\\file-manager-api.csproj",
        "--launch-profile",
        "http"
      ],
      "dependsOn": [
        "prepare launch file-manager-api"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "file-manager-api",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Determining projects to restore",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "run file-manager-blazor",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\file-manager-blazor\\FileManagerBlazor.csproj",
        "--launch-profile",
        "http"
      ],
      "dependsOn": [
        "run file-manager-api",
        "kill file-manager-blazor port 5167",
        "stop existing file-manager-blazor instances"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "blazor",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Determining projects to restore",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}
