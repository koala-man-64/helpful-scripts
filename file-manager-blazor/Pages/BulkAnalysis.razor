@page "/bulk-analysis"
@using Markdig
@implements IDisposable
@inject IBulkAnalysisResultProvider ResultProvider
@inject ChatContextState ChatContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@{
    var selectedDocuments = GetSelectedDocuments();
    var availableAnalysisTypes = GetAvailableAnalysisTypes(selectedDocuments);
    var selectedAnalysisTypes = GetSelectedAnalysisTypes(availableAnalysisTypes);
    var activeDocument = GetActiveDocument(selectedDocuments);
    var activeAnalysisType = GetActiveAnalysisType(selectedAnalysisTypes);
    var activeResult = activeDocument is null || activeAnalysisType is null
        ? null
        : activeDocument.Document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase));
    var selectedContextItems = GetSelectedContextItems();
    var selectedDownloadResults = GetSelectedDownloadResults();
    var selectedPreviewDocument = GetSelectionPreviewDocument(selectedDocuments);
    var selectedPreviewOrdinal = GetSelectionPreviewOrdinal(selectedDocuments, selectedPreviewDocument);
    var selectedTokens = selectedContextItems.Sum(item => item.EstimatedTokens);
    var isOverLimit = selectedTokens > ChatContextState.ContextLimitTokens;
    var usagePercent = Math.Min(100, selectedTokens * 100.0 / ChatContextState.ContextLimitTokens);
    var loadedIds = ChatContext.LoadedItems.Select(item => item.Id).ToHashSet(StringComparer.Ordinal);
    var hasDirtyLoadedContext = ChatContext.HasLoadedContext && !loadedIds.SetEquals(selectedContextIds);
}

<PageTitle>Bulk Analysis</PageTitle>

<header class="guided-workflow-header">
    <p class="page-kicker">Bulk document analysis</p>
    <h1>@HeaderTitle</h1>
    <p>@HeaderDescription</p>
    <div class="workflow-progress" aria-label="Workflow progress">
        <div class="workflow-progress-track">
            <span class="workflow-progress-fill" style="@($"width: {CurrentStepNumber * 100 / 3}%;")"></span>
        </div>
        <p class="workflow-step">Step @CurrentStepNumber of 3</p>
    </div>
    <div class="workflow-divider" aria-hidden="true"></div>
</header>

<section class="@($"guided-analysis-page {(workflowStep is WorkflowStep.SelectDocuments or WorkflowStep.Results ? "document-step-page" : "")}")" aria-label="Bulk Analysis workflow">
    @if (workflowStep == WorkflowStep.SelectDocuments)
    {
        <div class="document-step-layout">
            <section class="workflow-card document-selection-card" aria-labelledby="select-documents-title">
                <div class="workflow-card-header">
                    <div>
                        <h2 id="select-documents-title">
                            <span class="title-tooltip-trigger"
                                  tabindex="0"
                                  title="Choose the documents you want included in the bulk analysis review."
                                  data-tooltip="Choose the documents you want included in the bulk analysis review."
                                  aria-describedby="select-documents-tooltip">
                                Select documents
                            </span>
                        </h2>
                        <span id="select-documents-tooltip" class="sr-only">Choose the documents you want included in the bulk analysis review.</span>
                    </div>
                </div>

                @{
                    var visibleDocumentPanels = GetVisibleDocumentPanels();
                }

                <div class="document-selection-list">
                    @foreach (var folderPanel in visibleDocumentPanels)
                    {
                        var isCollapsed = IsFolderCollapsed(folderPanel.Folder.Id);
                        var selectedInFolder = folderPanel.VisibleDocuments.Count(document => selectedDocumentIds.Contains(document.Id));
                        var folderSelectionState = GetFolderSelectionState(folderPanel);

                        <section class="@GetFolderPanelClass(folderPanel)" style="@($"--folder-depth: {folderPanel.Depth};")">
                            <div class="document-folder-header">
                                <button type="button"
                                        class="@GetFolderSelectClass(folderSelectionState)"
                                        role="checkbox"
                                        aria-checked="@GetAriaChecked(folderSelectionState)"
                                        aria-label="@($"Select all documents under {folderPanel.Folder.DisplayName}")"
                                        @onclick="() => ToggleFolderSelection(folderPanel)"></button>
                                <button type="button"
                                        class="folder-collapse-button"
                                        aria-expanded="@(!isCollapsed)"
                                        aria-label="@($"Toggle {folderPanel.Folder.DisplayName}")"
                                        @onclick="() => ToggleFolderPanel(folderPanel.Folder.Id)">
                                    <span aria-hidden="true">@(isCollapsed ? ">" : "v")</span>
                                </button>
                                <div class="document-folder-heading">
                                    <div>
                                        <h3>@folderPanel.Folder.DisplayName</h3>
                                        @if (!string.IsNullOrWhiteSpace(folderPanel.Folder.ParentDisplayName))
                                        {
                                            <p>@folderPanel.Folder.ParentDisplayName</p>
                                        }
                                    </div>
                                    <span>@($"{selectedInFolder} of {folderPanel.VisibleDocumentCount} selected")</span>
                                </div>
                            </div>

                            @if (!isCollapsed && folderPanel.Documents.Count > 0)
                            {
                                <div class="document-option-list">
                                    @foreach (var document in folderPanel.Documents)
                                    {
                                        <label class="@GetDocumentOptionClass(document.Id)">
                                            <input type="checkbox"
                                                   checked="@selectedDocumentIds.Contains(document.Id)"
                                                   @onchange="() => ToggleDocumentSelection(document.Id)" />
                                            <span>
                                                <strong>@document.Title</strong>
                                                <small>@document.OriginalFileName - @($"{document.Results.Count} available analysis result{(document.Results.Count == 1 ? "" : "s")}")</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>

                @if (visibleDocumentPanels.Count == 0)
                {
                    <div class="workflow-empty-state">
                        <strong>No documents available</strong>
                        <span>Add documents to the provider before starting a bulk analysis.</span>
                    </div>
                }
            </section>

            <aside class="workflow-card step-one-preview-card" aria-label="Review inputs">
                @if (selectedPreviewDocument is null)
                {
                    <div class="workflow-empty-state step-preview-empty">
                        <strong>No input selected</strong>
                        <span>Select documents from the left panel to preview the Step 1 input set.</span>
                    </div>
                }
                else
                {
                    <div class="source-preview-summary">
                        <div class="source-preview-summary-copy">
                            <strong class="source-preview-title">@selectedPreviewDocument.Document.Title</strong>
                            <span class="source-preview-file-name">@selectedPreviewDocument.Document.OriginalFileName</span>
                            <div class="source-preview-summary-meta" aria-label="Source details">
                                <span class="source-preview-summary-meta-item">
                                    <span class="source-preview-summary-meta-label">Folder</span>
                                    <span class="source-preview-summary-meta-value">@GetFolderPath(selectedPreviewDocument.Folder)</span>
                                </span>
                                <span class="source-preview-summary-meta-item">
                                    <span class="source-preview-summary-meta-label">Token count</span>
                                    <span class="source-preview-summary-meta-value">@FormatTokens(BulkAnalysisContextItem.FromSourceDocument(selectedPreviewDocument.Folder, selectedPreviewDocument.Document).EstimatedTokens)</span>
                                </span>
                            </div>
                        </div>
                        <div class="source-preview-summary-controls">
                            <span class="selected-count">@($"{selectedPreviewOrdinal} of {selectedDocuments.Count}")</span>
                            @if (selectedDocuments.Count > 1)
                            {
                                <div class="preview-cycle-actions" aria-label="Cycle selected source documents">
                                    <button type="button" class="icon-button bordered" @onclick="() => PreviousSelectionPreviewDocument(selectedDocuments)" aria-label="Previous selected source document">&lt;</button>
                                    <button type="button" class="icon-button bordered" @onclick="() => NextSelectionPreviewDocument(selectedDocuments)" aria-label="Next selected source document">&gt;</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="source-preview-body">
                        <div class="source-preview-original">
                            <p class="control-label">Original content</p>
                            <pre>@GetOriginalDocumentContent(selectedPreviewDocument.Document)</pre>
                        </div>
                    </div>
                }
            </aside>
        </div>

        <footer class="workflow-footer document-step-actions">
            <button type="button" class="workflow-action-button secondary" @onclick="GoToHomePage">
                Back
            </button>
            <button type="button" class="workflow-action-button primary" disabled="@(selectedDocumentIds.Count == 0)" @onclick="GoToAnalysisStep">
                Next
            </button>
        </footer>
    }
    else if (workflowStep == WorkflowStep.SelectAnalysisTypes)
    {
        <section class="workflow-card" aria-labelledby="select-analysis-title">
            <div class="workflow-card-header">
                <div>
                    <h2 id="select-analysis-title">Select bulk analysis types</h2>
                    <p>Pick the generated result types you want to review across the selected documents.</p>
                </div>
                <span class="selected-count">@($"{selectedAnalysisTypeIds.Count} selected")</span>
            </div>

            <div class="analysis-type-grid">
                @foreach (var analysisType in availableAnalysisTypes)
                {
                    var matchingCount = selectedDocuments.Sum(document => document.Document.Results.Count(result => string.Equals(result.AnalysisType, analysisType, StringComparison.OrdinalIgnoreCase)));

                    <label class="@GetAnalysisOptionClass(analysisType)">
                        <input type="checkbox"
                               checked="@selectedAnalysisTypeIds.Contains(analysisType)"
                               @onchange="() => ToggleAnalysisType(analysisType)" />
                        <span class="analysis-option-icon" aria-hidden="true">@GetAnalysisGlyph(analysisType)</span>
                        <span>
                            <strong>@analysisType</strong>
                            <small>@GetAnalysisDescription(analysisType)</small>
                            <em>@($"{matchingCount} matching result{(matchingCount == 1 ? "" : "s")}")</em>
                        </span>
                    </label>
                }
            </div>

            @if (availableAnalysisTypes.Count == 0)
            {
                <div class="workflow-empty-state">
                    <strong>No analysis types available</strong>
                    <span>Go back and choose at least one document with generated analysis results.</span>
                </div>
            }

            <footer class="workflow-footer">
                <button type="button" class="workflow-action-button secondary" @onclick="GoToDocumentStep">Back</button>
                <button type="button" class="workflow-action-button primary" disabled="@(selectedAnalysisTypeIds.Count == 0)" @onclick="GoToResultsStep">
                    Next
                </button>
            </footer>
        </section>
    }
    else
    {
        <div class="document-step-layout results-step-layout">
            <section class="workflow-card document-selection-card result-selection-card" aria-labelledby="results-title">
                <div class="workflow-card-header">
                    <div>
                        <h2 id="results-title">
                            <span class="title-tooltip-trigger"
                                  tabindex="0"
                                  title="Review generated bulk analysis results for selected SOPs."
                                  data-tooltip="Review generated bulk analysis results for selected SOPs."
                                  aria-describedby="results-tooltip">
                                Results
                            </span>
                        </h2>
                        <span id="results-tooltip" class="sr-only">Review generated bulk analysis results for selected SOPs.</span>
                    </div>
                </div>

                @if (selectedDocuments.Count == 0 || selectedAnalysisTypes.Count == 0)
                {
                    <div class="workflow-empty-state">
                        <strong>Select documents and analysis types to review results.</strong>
                        <span>Use the previous steps to build a results set.</span>
                    </div>
                }
                else
                {
                    var visibleResultPanels = GetVisibleResultDocumentPanels(selectedDocuments);

                    <div class="document-selection-list result-document-list">
                        @foreach (var folderPanel in visibleResultPanels)
                        {
                            var isCollapsed = IsFolderCollapsed(folderPanel.Folder.Id);
                            var folderSelectionState = GetResultSelectionState(folderPanel.VisibleDocuments, selectedAnalysisTypes);
                            var selectedResultsInFolder = CountSelectedResults(folderPanel.VisibleDocuments, selectedAnalysisTypes);
                            var availableResultsInFolder = CountAvailableResults(folderPanel.VisibleDocuments, selectedAnalysisTypes);

                            <section class="@GetResultFolderPanelClass(folderPanel)" style="@($"--folder-depth: {folderPanel.Depth};")">
                                <div class="document-folder-header">
                                    <button type="button"
                                            class="@GetFolderSelectClass(folderSelectionState)"
                                            role="checkbox"
                                            aria-checked="@GetAriaChecked(folderSelectionState)"
                                            aria-label="@($"Select generated results under {folderPanel.Folder.DisplayName}")"
                                            disabled="@(availableResultsInFolder == 0)"
                                            @onclick="() => ToggleFolderResultContext(folderPanel, selectedAnalysisTypes)"></button>
                                    <button type="button"
                                            class="folder-collapse-button"
                                            aria-expanded="@(!isCollapsed)"
                                            aria-label="@($"Toggle {folderPanel.Folder.DisplayName}")"
                                            @onclick="() => ToggleFolderPanel(folderPanel.Folder.Id)">
                                        <span aria-hidden="true">@(isCollapsed ? ">" : "v")</span>
                                    </button>
                                    <div class="document-folder-heading">
                                        <div>
                                            <h3>@folderPanel.Folder.DisplayName</h3>
                                            @if (!string.IsNullOrWhiteSpace(folderPanel.Folder.ParentDisplayName))
                                            {
                                                <p>@folderPanel.Folder.ParentDisplayName</p>
                                            }
                                        </div>
                                        <span>@($"{selectedResultsInFolder} of {availableResultsInFolder} selected")</span>
                                    </div>
                                </div>

                                @if (!isCollapsed && folderPanel.Documents.Count > 0)
                                {
                                    <div class="document-option-list result-sop-list">
                                        @foreach (var document in folderPanel.Documents)
                                        {
                                            var documentSelectionState = GetResultSelectionState(document, selectedAnalysisTypes);
                                            var availableResultsForDocument = CountAvailableResults(document, selectedAnalysisTypes);

                                            <div class="@GetResultDocumentOptionClass(document.Id, documentSelectionState)">
                                                <input type="checkbox"
                                                       checked="@(documentSelectionState == SelectionState.Checked)"
                                                       disabled="@(availableResultsForDocument == 0)"
                                                       aria-label="@($"Select generated results for {document.Title}")"
                                                       @onchange="() => ToggleDocumentResultContext(document, selectedAnalysisTypes)" />
                                                <button type="button"
                                                        class="result-document-preview-button"
                                                        @onclick="() => SetActiveDocument(document.Id)">
                                                    <strong>@document.Title</strong>
                                                    <small>@document.OriginalFileName - @GetResultAvailabilitySummary(document, selectedAnalysisTypes)</small>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }
            </section>

            <aside class="workflow-card step-one-preview-card result-preview-panel" aria-label="Review generated result">
                @if (activeDocument is null || activeAnalysisType is null)
                {
                    <div class="workflow-empty-state step-preview-empty">
                        <strong>No result selected</strong>
                        <span>Select an SOP from the left panel to preview generated analysis.</span>
                    </div>
                }
                else
                {
                    <div class="source-preview-summary result-preview-summary">
                        <div class="source-preview-summary-copy">
                            <strong class="source-preview-title">@activeDocument.Document.Title</strong>
                            <span class="source-preview-file-name">@activeDocument.Document.OriginalFileName</span>
                            <div class="source-preview-summary-meta" aria-label="Result details">
                                <span class="source-preview-summary-meta-item">
                                    <span class="source-preview-summary-meta-label">Folder</span>
                                    <span class="source-preview-summary-meta-value">@GetFolderPath(activeDocument.Folder)</span>
                                </span>
                                <span class="source-preview-summary-meta-item">
                                    <span class="source-preview-summary-meta-label">Type</span>
                                    <span class="source-preview-summary-meta-value">@activeAnalysisType</span>
                                </span>
                                @if (activeResult is not null)
                                {
                                    <span class="source-preview-summary-meta-item">
                                        <span class="source-preview-summary-meta-label">Tokens</span>
                                        <span class="source-preview-summary-meta-value">@FormatTokens(activeResult.EstimatedTokens)</span>
                                    </span>
                                    <span class="source-preview-summary-meta-item">
                                        <span class="source-preview-summary-meta-label">Generated</span>
                                        <span class="source-preview-summary-meta-value">@activeResult.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="source-preview-summary-controls">
                            <span class="selected-count">@($"{GetSelectionPreviewOrdinal(selectedDocuments, activeDocument)} of {selectedDocuments.Count}")</span>
                            <div class="preview-cycle-actions result-cycle-actions" aria-label="Cycle selected results">
                                <button type="button" class="icon-button bordered" @onclick="PreviousDocument" aria-label="Previous SOP">&lt;</button>
                                <button type="button" class="icon-button bordered" @onclick="NextDocument" aria-label="Next SOP">&gt;</button>
                                <button type="button" class="icon-button bordered text-button" @onclick="PreviousAnalysisType" aria-label="Previous analysis type">&lt; Type</button>
                                <button type="button" class="icon-button bordered text-button" @onclick="NextAnalysisType" aria-label="Next analysis type">Type &gt;</button>
                            </div>
                        </div>
                    </div>

                    <div class="source-preview-body result-preview-body">
                        <div class="source-preview-original result-preview-output">
                            <p class="control-label">@activeAnalysisType</p>
                            @if (activeResult is null)
                            {
                                <div class="workflow-empty-state preview-empty">
                                    <strong>No @activeAnalysisType result for this SOP</strong>
                                    <span>Use the analysis-type navigation to view another generated result.</span>
                                </div>
                            }
                            else if (!activeResult.IsPreviewAvailable)
                            {
                                <div class="workflow-empty-state preview-empty">
                                    <strong>This analysis result is not available for preview.</strong>
                                    <span>It can still be selected for assistant context.</span>
                                </div>
                            }
                            else
                            {
                                <article class="markdown-preview">
                                    @RenderMarkdown(activeResult)
                                </article>
                            }
                        </div>
                    </div>

                    <section class="@($"result-context-panel {(isOverLimit ? "over-limit" : "")}")" aria-label="Load context">
                        <div class="bulk-card-title-row result-context-title">
                            <div>
                                <h2>Load context</h2>
                                <p>@($"{selectedContextItems.Count} selected - {FormatTokens(selectedTokens)} / {FormatTokens(ChatContextState.ContextLimitTokens)}")</p>
                            </div>
                        </div>

                        <div class="context-meter" aria-label="Context usage">
                            <span style="@($"width: {FormatPercent(usagePercent)}%;")"></span>
                        </div>

                        @{
                            var sourceDocumentId = GetSourceDocumentContextId(activeDocument.Document);
                        }

                        <div class="result-context-choice-grid">
                            <label class="@GetContextChoiceClass(sourceDocumentId)">
                                <input type="checkbox"
                                       checked="@selectedContextIds.Contains(sourceDocumentId)"
                                       @onchange="() => ToggleSourceDocumentContext(activeDocument.Folder, activeDocument.Document)" />
                                <span>
                                    <strong>@activeDocument.Document.OriginalFileName</strong>
                                    <small>Source document - @activeDocument.Document.Title</small>
                                </span>
                            </label>

                            @if (activeResult is not null)
                            {
                                <label class="@GetContextChoiceClass(activeResult.Id)">
                                    <input type="checkbox"
                                           checked="@selectedContextIds.Contains(activeResult.Id)"
                                           @onchange="() => ToggleResultContext(activeResult)" />
                                    <span>
                                        <strong>@activeResult.AnalysisType</strong>
                                        <small>Generated result - @activeResult.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</small>
                                    </span>
                                </label>
                            }
                        </div>

                        @if (selectedContextItems.Count == 0)
                        {
                            <p class="muted-copy">Select a source document or generated result to continue.</p>
                        }
                        else
                        {
                            <div class="selected-chip-list selected-context-stack" aria-label="Selected context items">
                                @foreach (var item in selectedContextItems)
                                {
                                    <span class="selected-chip">
                                        @item.DisplayName
                                        <button type="button" @onclick="() => RemoveContextItem(item.Id)" aria-label="@($"Remove {item.DisplayName}")">x</button>
                                    </span>
                                }
                            </div>
                        }

                        @if (isOverLimit)
                        {
                            <p class="inline-warning">Too much content selected. Remove one or more items before loading context.</p>
                        }
                        else if (ChatContext.HasLoadedContext && !hasDirtyLoadedContext)
                        {
                            <p class="inline-success">This context is already loaded.</p>
                        }
                        else if (hasDirtyLoadedContext)
                        {
                            <p class="inline-notice">Selection changed. Load context again to update the assistant page.</p>
                        }

                    </section>
                }
            </aside>
        </div>

        <footer class="workflow-footer document-step-actions result-step-actions">
            <button type="button" class="workflow-action-button secondary" @onclick="GoToAnalysisStep">Back</button>
            <div class="result-step-primary-actions">
                @if (ChatContext.HasLoadedContext)
                {
                    <button type="button" class="workflow-action-button secondary" @onclick="GoToAssistantContext">
                        Go to context page
                    </button>
                }
                <button type="button"
                        class="workflow-action-button primary"
                        disabled="@(selectedDownloadResults.Count == 0)"
                        @onclick="DownloadSelectedResults">
                    Download results
                </button>
                <button type="button"
                        class="workflow-action-button primary"
                        disabled="@(selectedContextItems.Count == 0 || isOverLimit)"
                        @onclick="LoadContext">
                    Load selected context
                </button>
            </div>
        </footer>
    }
</section>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private IReadOnlyList<BulkAnalysisFolder> allFolders = [];
    private readonly HashSet<string> selectedDocumentIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedAnalysisTypeIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> selectedContextIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> collapsedFolderIds = new(StringComparer.Ordinal);
    private WorkflowStep workflowStep = WorkflowStep.SelectDocuments;
    private string? activeDocumentId;
    private string? activeAnalysisType;
    private string? selectionPreviewDocumentId;

    private IReadOnlyList<BulkAnalysisFolder> AllFolders => allFolders;

    private IReadOnlyList<DocumentWithFolder> AllDocuments =>
        allFolders.SelectMany(EnumerateDocuments).ToArray();

    private IReadOnlyList<BulkAnalysisResult> AllResults =>
        AllDocuments.SelectMany(entry => entry.Document.Results).ToArray();

    private int CurrentStepNumber =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => 1,
            WorkflowStep.SelectAnalysisTypes => 2,
            _ => 3
        };

    private string HeaderTitle =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => "Bulk Analysis",
            WorkflowStep.SelectAnalysisTypes => "Choose analysis types",
            _ => "Review results"
        };

    private string HeaderDescription =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => "Select the documents you want to analyze before choosing the bulk review outputs.",
            WorkflowStep.SelectAnalysisTypes => "Choose the analysis outputs to compare across the selected documents.",
            _ => "Navigate between selected SOPs and analysis types, then load documents or results into assistant context."
        };

    protected override async Task OnInitializedAsync()
    {
        ChatContext.Changed += HandleChatContextChanged;
        await RefreshAsync();
        RestoreLoadedContextSelection();
        EnsureActiveTargets();
    }

    private async Task RefreshAsync()
    {
        allFolders = await ResultProvider.GetFoldersAsync();
        CollapseAllFolders();
    }

    private void CollapseAllFolders()
    {
        collapsedFolderIds.Clear();

        foreach (var folder in EnumerateFolders(AllFolders))
        {
            collapsedFolderIds.Add(folder.Id);
        }
    }

    private static IEnumerable<BulkAnalysisFolder> EnumerateFolders(IEnumerable<BulkAnalysisFolder> folders)
    {
        foreach (var folder in folders)
        {
            yield return folder;

            foreach (var childFolder in EnumerateFolders(folder.ChildFolders))
            {
                yield return childFolder;
            }
        }
    }

    private void RestoreLoadedContextSelection()
    {
        if (!ChatContext.HasLoadedContext)
        {
            return;
        }

        foreach (var item in ChatContext.LoadedItems)
        {
            selectedContextIds.Add(item.Id);

            if (item.Kind == BulkAnalysisContextItemKind.SourceDocument)
            {
                var sourceDocument = AllDocuments.FirstOrDefault(entry => string.Equals(GetSourceDocumentContextId(entry.Document), item.Id, StringComparison.Ordinal));
                if (sourceDocument is not null)
                {
                    selectedDocumentIds.Add(sourceDocument.Document.Id);
                }
            }
            else
            {
                var result = AllResults.FirstOrDefault(result => string.Equals(result.Id, item.Id, StringComparison.Ordinal));
                if (result is not null)
                {
                    selectedDocumentIds.Add(result.DocumentId);
                    selectedAnalysisTypeIds.Add(result.AnalysisType);
                }
            }
        }

        if (selectedDocumentIds.Count > 0 && selectedAnalysisTypeIds.Count > 0)
        {
            workflowStep = WorkflowStep.Results;
        }
        else if (selectedDocumentIds.Count > 0)
        {
            workflowStep = WorkflowStep.SelectAnalysisTypes;
        }
    }

    private static IEnumerable<DocumentWithFolder> EnumerateDocuments(BulkAnalysisFolder folder)
    {
        foreach (var document in folder.Documents)
        {
            yield return new DocumentWithFolder(folder, document);
        }

        foreach (var childFolder in folder.ChildFolders)
        {
            foreach (var document in EnumerateDocuments(childFolder))
            {
                yield return document;
            }
        }
    }

    private IReadOnlyList<DocumentFolderPanel> GetFilteredDocumentPanels()
    {
        var panels = new List<DocumentFolderPanel>();

        foreach (var folder in AllFolders.OrderBy(folder => folder.DisplayName, StringComparer.OrdinalIgnoreCase))
        {
            var panel = BuildDocumentPanel(folder, depth: 0);
            if (panel is not null)
            {
                panels.Add(panel);
            }
        }

        return panels;
    }

    private DocumentFolderPanel? BuildDocumentPanel(BulkAnalysisFolder folder, int depth)
    {
        var documents = folder.Documents
            .OrderBy(document => document.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var childPanels = folder.ChildFolders
            .OrderBy(child => child.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Select(child => BuildDocumentPanel(child, depth + 1))
            .Where(panel => panel is not null)
            .Select(panel => panel!)
            .ToArray();

        return documents.Length == 0 && childPanels.Length == 0
            ? null
            : new DocumentFolderPanel(folder, documents, childPanels, depth);
    }

    private IReadOnlyList<DocumentFolderPanel> GetVisibleDocumentPanels()
    {
        var panels = new List<DocumentFolderPanel>();

        foreach (var panel in GetFilteredDocumentPanels())
        {
            AddVisibleDocumentPanels(panel, panels);
        }

        return panels;
    }

    private IReadOnlyList<DocumentFolderPanel> GetVisibleResultDocumentPanels(IReadOnlyList<DocumentWithFolder> selectedDocuments)
    {
        var panels = new List<DocumentFolderPanel>();

        foreach (var folderGroup in selectedDocuments
            .GroupBy(entry => entry.Folder.Id)
            .OrderBy(group => group.First().Folder.DisplayName, StringComparer.OrdinalIgnoreCase))
        {
            var folder = folderGroup.First().Folder;
            var documents = folderGroup
                .Select(entry => entry.Document)
                .OrderBy(document => document.Title, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            var panel = new DocumentFolderPanel(folder, documents, Array.Empty<DocumentFolderPanel>(), 0);
            panels.Add(panel);
        }

        return panels;
    }

    private void AddVisibleDocumentPanels(DocumentFolderPanel panel, List<DocumentFolderPanel> panels)
    {
        panels.Add(panel);

        if (IsFolderCollapsed(panel.Folder.Id))
        {
            return;
        }

        foreach (var childPanel in panel.Children)
        {
            AddVisibleDocumentPanels(childPanel, panels);
        }
    }

    private void ToggleDocumentSelection(string documentId)
    {
        if (!selectedDocumentIds.Add(documentId))
        {
            selectedDocumentIds.Remove(documentId);
            RemoveContextForDocument(documentId);
        }

        PruneAnalysisTypeSelection();
        EnsureSelectionPreviewTarget();
        EnsureActiveTargets();
    }

    private void ToggleFolderSelection(DocumentFolderPanel panel)
    {
        var documents = panel.VisibleDocuments;

        if (documents.Count == 0)
        {
            return;
        }

        if (GetFolderSelectionState(panel) == SelectionState.Checked)
        {
            foreach (var document in documents)
            {
                selectedDocumentIds.Remove(document.Id);
                RemoveContextForDocument(document.Id);
            }
        }
        else
        {
            foreach (var document in documents)
            {
                selectedDocumentIds.Add(document.Id);
            }
        }

        PruneAnalysisTypeSelection();
        EnsureSelectionPreviewTarget();
        EnsureActiveTargets();
    }

    private void ToggleAnalysisType(string analysisType)
    {
        if (!selectedAnalysisTypeIds.Add(analysisType))
        {
            selectedAnalysisTypeIds.Remove(analysisType);
            RemoveContextForAnalysisType(analysisType);
        }

        EnsureActiveTargets();
    }

