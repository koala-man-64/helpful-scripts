@page "/bulk-analysis"
@using Markdig
@implements IDisposable
@inject IBulkAnalysisResultProvider ResultProvider
@inject ChatContextState ChatContext
@inject NavigationManager NavigationManager

@{
    var selectedDocuments = GetSelectedDocuments();
    var availableAnalysisTypes = GetAvailableAnalysisTypes(selectedDocuments);
    var selectedAnalysisTypes = GetSelectedAnalysisTypes(availableAnalysisTypes);
    var activeDocument = GetActiveDocument(selectedDocuments);
    var activeAnalysisType = GetActiveAnalysisType(selectedAnalysisTypes);
    var activeResult = activeDocument is null || activeAnalysisType is null
        ? null
        : activeDocument.Document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase));
    var selectedContextItems = GetSelectedContextItems();
    var selectedPreviewDocument = GetSelectionPreviewDocument(selectedDocuments);
    var selectedPreviewOrdinal = GetSelectionPreviewOrdinal(selectedDocuments, selectedPreviewDocument);
    var selectedTokens = selectedContextItems.Sum(item => item.EstimatedTokens);
    var isOverLimit = selectedTokens > ChatContextState.ContextLimitTokens;
    var usagePercent = Math.Min(100, selectedTokens * 100.0 / ChatContextState.ContextLimitTokens);
    var loadedIds = ChatContext.LoadedItems.Select(item => item.Id).ToHashSet(StringComparer.Ordinal);
    var hasDirtyLoadedContext = ChatContext.HasLoadedContext && !loadedIds.SetEquals(selectedContextIds);
}

<PageTitle>Bulk Analysis</PageTitle>

<header class="guided-workflow-header">
    <p class="page-kicker">Bulk document analysis</p>
    <h1>@HeaderTitle</h1>
    <p>@HeaderDescription</p>
    <div class="workflow-progress" aria-label="Workflow progress">
        <div class="workflow-progress-track">
            <span class="workflow-progress-fill" style="@($"width: {CurrentStepNumber * 100 / 3}%;")"></span>
        </div>
        <p class="workflow-step">Step @CurrentStepNumber of 3</p>
    </div>
    <div class="workflow-divider" aria-hidden="true"></div>
</header>

<section class="@($"guided-analysis-page {(workflowStep == WorkflowStep.SelectDocuments ? "document-step-page" : "")}")" aria-label="Bulk Analysis workflow">
    @if (workflowStep == WorkflowStep.SelectDocuments)
    {
        <div class="document-step-layout">
            <section class="workflow-card document-selection-card" aria-labelledby="select-documents-title">
                <div class="workflow-card-header">
                    <div>
                        <h2 id="select-documents-title">
                            <span class="title-tooltip-trigger"
                                  tabindex="0"
                                  title="Choose the documents you want included in the bulk analysis review."
                                  data-tooltip="Choose the documents you want included in the bulk analysis review."
                                  aria-describedby="select-documents-tooltip">
                                Select documents
                            </span>
                        </h2>
                        <span id="select-documents-tooltip" class="sr-only">Choose the documents you want included in the bulk analysis review.</span>
                    </div>
                    <span class="selected-count">@($"{selectedDocumentIds.Count} selected")</span>
                </div>

                <div class="selection-toolbar">
                    <label class="form-control search-box">
                        <span class="control-label">Search</span>
                        <input type="search"
                               placeholder="Search documents, folders, or source files..."
                               value="@documentSearchTerm"
                               @oninput="HandleDocumentSearchInput" />
                    </label>
                    <div class="inline-actions">
                        <button type="button" class="secondary-button" @onclick="SelectVisibleDocuments">Select visible</button>
                        <button type="button" class="secondary-button" @onclick="ClearDocumentSelection">Clear</button>
                    </div>
                </div>

                @{
                    var visibleDocumentPanels = GetVisibleDocumentPanels();
                }

                <div class="document-selection-list">
                    @foreach (var folderPanel in visibleDocumentPanels)
                    {
                        var isCollapsed = IsFolderCollapsed(folderPanel.Folder.Id);
                        var selectedInFolder = folderPanel.VisibleDocuments.Count(document => selectedDocumentIds.Contains(document.Id));
                        var folderSelectionState = GetFolderSelectionState(folderPanel);

                        <section class="@GetFolderPanelClass(folderPanel)" style="@($"--folder-depth: {folderPanel.Depth};")">
                            <div class="document-folder-header">
                                <button type="button"
                                        class="@GetFolderSelectClass(folderSelectionState)"
                                        role="checkbox"
                                        aria-checked="@GetAriaChecked(folderSelectionState)"
                                        aria-label="@($"Select all documents under {folderPanel.Folder.DisplayName}")"
                                        @onclick="() => ToggleFolderSelection(folderPanel)"></button>
                                <button type="button"
                                        class="folder-collapse-button"
                                        aria-expanded="@(!isCollapsed)"
                                        aria-label="@($"Toggle {folderPanel.Folder.DisplayName}")"
                                        @onclick="() => ToggleFolderPanel(folderPanel.Folder.Id)">
                                    <span aria-hidden="true">@(isCollapsed ? ">" : "v")</span>
                                </button>
                                <div class="document-folder-heading">
                                    <div>
                                        <h3>@folderPanel.Folder.DisplayName</h3>
                                        @if (!string.IsNullOrWhiteSpace(folderPanel.Folder.ParentDisplayName))
                                        {
                                            <p>@folderPanel.Folder.ParentDisplayName</p>
                                        }
                                    </div>
                                    <span>@($"{selectedInFolder} of {folderPanel.VisibleDocumentCount} selected")</span>
                                </div>
                            </div>

                            @if (!isCollapsed && folderPanel.Documents.Count > 0)
                            {
                                <div class="document-option-list">
                                    @foreach (var document in folderPanel.Documents)
                                    {
                                        <label class="@GetDocumentOptionClass(document.Id)">
                                            <input type="checkbox"
                                                   checked="@selectedDocumentIds.Contains(document.Id)"
                                                   @onchange="() => ToggleDocumentSelection(document.Id)" />
                                            <span>
                                                <strong>@document.Title</strong>
                                                <small>@document.OriginalFileName - @($"{document.Results.Count} available analysis result{(document.Results.Count == 1 ? "" : "s")}")</small>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>

                @if (visibleDocumentPanels.Count == 0)
                {
                    <div class="workflow-empty-state">
                        <strong>No matching documents</strong>
                        <span>Clear the search or enter a different folder, file, or document name.</span>
                    </div>
                }

                <footer class="workflow-footer">
                    <span>@($"{AllDocuments.Count} documents available")</span>
                    <button type="button" class="workflow-action-button primary" disabled="@(selectedDocumentIds.Count == 0)" @onclick="GoToAnalysisStep">
                        Next
                    </button>
                </footer>
            </section>

            <aside class="workflow-card step-one-preview-card" aria-labelledby="step-one-preview-title">
                <div class="step-one-preview-header">
                    <div>
                        <p class="page-kicker">Step 1</p>
                        <h2 id="step-one-preview-title">
                            <span class="title-tooltip-trigger"
                                  tabindex="0"
                                  title="Cycle through selected source documents before choosing bulk analysis outputs."
                                  data-tooltip="Cycle through selected source documents before choosing bulk analysis outputs."
                                  aria-describedby="step-one-preview-tooltip">
                                Review inputs
                            </span>
                        </h2>
                        <span id="step-one-preview-tooltip" class="sr-only">Cycle through selected source documents before choosing bulk analysis outputs.</span>
                    </div>
                    @if (selectedPreviewDocument is not null)
                    {
                        <span class="selected-count">@($"{selectedPreviewOrdinal} of {selectedDocuments.Count}")</span>
                    }
                </div>

                @if (selectedPreviewDocument is null)
                {
                    <div class="workflow-empty-state step-preview-empty">
                        <strong>No input selected</strong>
                        <span>Select documents from the left panel to preview the Step 1 input set.</span>
                    </div>
                }
                else
                {
                    <div class="source-preview-summary">
                        <div>
                            <strong>@selectedPreviewDocument.Document.Title</strong>
                            <span>@selectedPreviewDocument.Document.OriginalFileName</span>
                        </div>
                    </div>

                    @if (selectedDocuments.Count > 1)
                    {
                        <div class="preview-cycle-actions" aria-label="Cycle selected source documents">
                            <button type="button" class="icon-button bordered" @onclick="() => PreviousSelectionPreviewDocument(selectedDocuments)" aria-label="Previous selected source document">&lt;</button>
                            <button type="button" class="icon-button bordered" @onclick="() => NextSelectionPreviewDocument(selectedDocuments)" aria-label="Next selected source document">&gt;</button>
                        </div>
                    }

                    <div class="source-preview-body">
                        <dl class="source-preview-details">
                            <div>
                                <dt>Folder</dt>
                                <dd>@selectedPreviewDocument.Folder.DisplayName</dd>
                            </div>
                            <div>
                                <dt>Available outputs</dt>
                                <dd>@GetAnalysisTypeSummary(selectedPreviewDocument.Document)</dd>
                            </div>
                            <div>
                                <dt>Context estimate</dt>
                                <dd>@FormatTokens(BulkAnalysisContextItem.FromSourceDocument(selectedPreviewDocument.Folder, selectedPreviewDocument.Document).EstimatedTokens)</dd>
                            </div>
                        </dl>

                        <div class="source-preview-original">
                            <p class="control-label">Original content</p>
                            <pre>@GetOriginalDocumentContent(selectedPreviewDocument.Document)</pre>
                        </div>
                    </div>
                }
            </aside>
        </div>
    }
    else if (workflowStep == WorkflowStep.SelectAnalysisTypes)
    {
        <section class="workflow-card" aria-labelledby="select-analysis-title">
            <div class="workflow-card-header">
                <div>
                    <h2 id="select-analysis-title">Select bulk analysis types</h2>
                    <p>Pick the generated result types you want to review across the selected documents.</p>
                </div>
                <span class="selected-count">@($"{selectedAnalysisTypeIds.Count} selected")</span>
            </div>

            <div class="selected-summary-strip">
                @foreach (var document in selectedDocuments.Take(4))
                {
                    <span class="context-chip">@document.Document.Title</span>
                }
                @if (selectedDocuments.Count > 4)
                {
                    <span class="context-chip muted">@($"+{selectedDocuments.Count - 4} more documents")</span>
                }
            </div>

            <div class="analysis-type-grid">
                @foreach (var analysisType in availableAnalysisTypes)
                {
                    var matchingCount = selectedDocuments.Sum(document => document.Document.Results.Count(result => string.Equals(result.AnalysisType, analysisType, StringComparison.OrdinalIgnoreCase)));

                    <label class="@GetAnalysisOptionClass(analysisType)">
                        <input type="checkbox"
                               checked="@selectedAnalysisTypeIds.Contains(analysisType)"
                               @onchange="() => ToggleAnalysisType(analysisType)" />
                        <span class="analysis-option-icon" aria-hidden="true">@GetAnalysisGlyph(analysisType)</span>
                        <span>
                            <strong>@analysisType</strong>
                            <small>@GetAnalysisDescription(analysisType)</small>
                            <em>@($"{matchingCount} matching result{(matchingCount == 1 ? "" : "s")}")</em>
                        </span>
                    </label>
                }
            </div>

            @if (availableAnalysisTypes.Count == 0)
            {
                <div class="workflow-empty-state">
                    <strong>No analysis types available</strong>
                    <span>Go back and choose at least one document with generated analysis results.</span>
                </div>
            }

            <footer class="workflow-footer">
                <button type="button" class="workflow-action-button secondary" @onclick="GoToDocumentStep">Back</button>
                <button type="button" class="workflow-action-button primary" disabled="@(selectedAnalysisTypeIds.Count == 0)" @onclick="GoToResultsStep">
                    Next
                </button>
            </footer>
        </section>
    }
    else
    {
        <section class="workflow-card results-workflow-card" aria-labelledby="results-title">
            <div class="workflow-card-header">
                <div>
                    <h2 id="results-title">Results</h2>
                    <p>Move between documents and analysis types, then choose documents or results for assistant context.</p>
                </div>
                <div class="bulk-card-actions">
                    <button type="button" class="secondary-button" @onclick="GoToAnalysisStep">Edit analysis types</button>
                    <button type="button" class="secondary-button" @onclick="GoToDocumentStep">Edit documents</button>
                </div>
            </div>

            <div class="result-navigation-panel">
                <section aria-label="Selected documents">
                    <div class="control-label">Documents</div>
                    <div class="result-tab-row">
                        @foreach (var document in selectedDocuments)
                        {
                            <button type="button"
                                    class="@GetResultTabClass(string.Equals(activeDocument?.Document.Id, document.Document.Id, StringComparison.Ordinal))"
                                    @onclick="() => SetActiveDocument(document.Document.Id)">
                                @document.Document.Title
                            </button>
                        }
                    </div>
                </section>

                <section aria-label="Selected analysis types">
                    <div class="control-label">Bulk analysis types</div>
                    <div class="result-tab-row">
                        @foreach (var analysisType in selectedAnalysisTypes)
                        {
                            <button type="button"
                                    class="@GetResultTabClass(string.Equals(activeAnalysisType, analysisType, StringComparison.OrdinalIgnoreCase))"
                                    @onclick="() => SetActiveAnalysisType(analysisType)">
                                @analysisType
                            </button>
                        }
                    </div>
                </section>
            </div>

            <div class="results-grid">
                <section class="result-preview-card" aria-label="Result preview">
                    @if (activeDocument is null || activeAnalysisType is null)
                    {
                        <div class="workflow-empty-state preview-empty">
                            <strong>Select documents and analysis types to review results.</strong>
                            <span>Use the previous steps to build a results set.</span>
                        </div>
                    }
                    else
                    {
                        <header class="preview-header compact-preview-header">
                            <div>
                                <p class="page-kicker">Preview</p>
                                <h2>@activeDocument.Document.Title</h2>
                                <p>@activeDocument.Folder.DisplayName - @activeAnalysisType</p>
                            </div>
                            <div class="preview-actions">
                                <button type="button" class="icon-button bordered" @onclick="PreviousDocument" aria-label="Previous document">&lt;</button>
                                <button type="button" class="icon-button bordered" @onclick="NextDocument" aria-label="Next document">&gt;</button>
                                <button type="button" class="icon-button bordered" @onclick="PreviousAnalysisType" aria-label="Previous analysis type">&lt; Type</button>
                                <button type="button" class="icon-button bordered" @onclick="NextAnalysisType" aria-label="Next analysis type">Type &gt;</button>
                            </div>
                        </header>

                        <div class="preview-body">
                            @if (activeResult is null)
                            {
                                <div class="workflow-empty-state preview-empty">
                                    <strong>No @activeAnalysisType result for this document</strong>
                                    <span>Use the analysis-type navigation to view another generated result.</span>
                                </div>
                            }
                            else if (!activeResult.IsPreviewAvailable)
                            {
                                <div class="workflow-empty-state preview-empty">
                                    <strong>This analysis result is not available for preview.</strong>
                                    <span>It can still be selected for assistant context.</span>
                                </div>
                            }
                            else
                            {
                                <article class="markdown-preview">
                                    @RenderMarkdown(activeResult)
                                </article>
                            }
                        </div>
                    }
                </section>

                <aside class="@($"context-load-card {(isOverLimit ? "over-limit" : "")}")" aria-label="Load context">
                    <div class="bulk-card-title-row">
                        <div>
                            <h2>Load context</h2>
                            <p>@($"{selectedContextItems.Count} selected - {FormatTokens(selectedTokens)} / {FormatTokens(ChatContextState.ContextLimitTokens)}")</p>
                        </div>
                    </div>

                    <div class="context-meter" aria-label="Context usage">
                        <span style="@($"width: {FormatPercent(usagePercent)}%;")"></span>
                    </div>

                    @if (activeDocument is not null)
                    {
                        var sourceDocumentId = GetSourceDocumentContextId(activeDocument.Document);

                        <label class="@GetContextChoiceClass(sourceDocumentId)">
                            <input type="checkbox"
                                   checked="@selectedContextIds.Contains(sourceDocumentId)"
                                   @onchange="() => ToggleSourceDocumentContext(activeDocument.Folder, activeDocument.Document)" />
                            <span>
                                <strong>@activeDocument.Document.OriginalFileName</strong>
                                <small>Source document - @activeDocument.Document.Title</small>
                            </span>
                        </label>
                    }

                    @if (activeResult is not null)
                    {
                        <label class="@GetContextChoiceClass(activeResult.Id)">
                            <input type="checkbox"
                                   checked="@selectedContextIds.Contains(activeResult.Id)"
                                   @onchange="() => ToggleResultContext(activeResult)" />
                            <span>
                                <strong>@activeResult.AnalysisType</strong>
                                <small>Generated result - @activeResult.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</small>
                            </span>
                        </label>
                    }

                    @if (selectedContextItems.Count == 0)
                    {
                        <p class="muted-copy">Select a source document or generated result to continue.</p>
                    }
                    else
                    {
                        <div class="selected-chip-list selected-context-stack" aria-label="Selected context items">
                            @foreach (var item in selectedContextItems)
                            {
                                <span class="selected-chip">
                                    @item.DisplayName
                                    <button type="button" @onclick="() => RemoveContextItem(item.Id)" aria-label="@($"Remove {item.DisplayName}")">x</button>
                                </span>
                            }
                        </div>
                    }

                    @if (isOverLimit)
                    {
                        <p class="inline-warning">Too much content selected. Remove one or more items before loading context.</p>
                    }
                    else if (ChatContext.HasLoadedContext && !hasDirtyLoadedContext)
                    {
                        <p class="inline-success">This context is already loaded.</p>
                    }
                    else if (hasDirtyLoadedContext)
                    {
                        <p class="inline-notice">Selection changed. Load context again to update the assistant page.</p>
                    }

                    <div class="context-load-actions">
                        <button type="button"
                                class="workflow-action-button primary"
                                disabled="@(selectedContextItems.Count == 0 || isOverLimit)"
                                @onclick="LoadContext">
                            Load selected context
                        </button>
                        @if (ChatContext.HasLoadedContext)
                        {
                            <button type="button" class="workflow-action-button secondary" @onclick="GoToAssistantContext">
                                Go to context page
                            </button>
                        }
                    </div>
                </aside>
            </div>
        </section>
    }
</section>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private IReadOnlyList<BulkAnalysisFolder> allFolders = [];
    private readonly HashSet<string> selectedDocumentIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedAnalysisTypeIds = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> selectedContextIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> collapsedFolderIds = new(StringComparer.Ordinal);
    private WorkflowStep workflowStep = WorkflowStep.SelectDocuments;
    private string documentSearchTerm = string.Empty;
    private string? activeDocumentId;
    private string? activeAnalysisType;
    private string? selectionPreviewDocumentId;

    private IReadOnlyList<BulkAnalysisFolder> AllFolders => allFolders;

    private IReadOnlyList<DocumentWithFolder> AllDocuments =>
        allFolders.SelectMany(EnumerateDocuments).ToArray();

    private IReadOnlyList<BulkAnalysisResult> AllResults =>
        AllDocuments.SelectMany(entry => entry.Document.Results).ToArray();

    private int CurrentStepNumber =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => 1,
            WorkflowStep.SelectAnalysisTypes => 2,
            _ => 3
        };

    private string HeaderTitle =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => "Bulk Analysis",
            WorkflowStep.SelectAnalysisTypes => "Choose analysis types",
            _ => "Review results"
        };

    private string HeaderDescription =>
        workflowStep switch
        {
            WorkflowStep.SelectDocuments => "Select the documents you want to analyze before choosing the bulk review outputs.",
            WorkflowStep.SelectAnalysisTypes => "Choose the analysis outputs to compare across the selected documents.",
            _ => "Navigate between documents and analysis types, then load documents or results into assistant context."
        };

    protected override async Task OnInitializedAsync()
    {
        ChatContext.Changed += HandleChatContextChanged;
        await RefreshAsync();
        RestoreLoadedContextSelection();
        EnsureActiveTargets();
    }

    private async Task RefreshAsync()
    {
        allFolders = await ResultProvider.GetFoldersAsync();
        CollapseAllFolders();
    }

    private void CollapseAllFolders()
    {
        collapsedFolderIds.Clear();

        foreach (var folder in EnumerateFolders(AllFolders))
        {
            collapsedFolderIds.Add(folder.Id);
        }
    }

    private static IEnumerable<BulkAnalysisFolder> EnumerateFolders(IEnumerable<BulkAnalysisFolder> folders)
    {
        foreach (var folder in folders)
        {
            yield return folder;

            foreach (var childFolder in EnumerateFolders(folder.ChildFolders))
            {
                yield return childFolder;
            }
        }
    }

    private void RestoreLoadedContextSelection()
    {
        if (!ChatContext.HasLoadedContext)
        {
            return;
        }

        foreach (var item in ChatContext.LoadedItems)
        {
            selectedContextIds.Add(item.Id);

            if (item.Kind == BulkAnalysisContextItemKind.SourceDocument)
            {
                var sourceDocument = AllDocuments.FirstOrDefault(entry => string.Equals(GetSourceDocumentContextId(entry.Document), item.Id, StringComparison.Ordinal));
                if (sourceDocument is not null)
                {
                    selectedDocumentIds.Add(sourceDocument.Document.Id);
                }
            }
            else
            {
                var result = AllResults.FirstOrDefault(result => string.Equals(result.Id, item.Id, StringComparison.Ordinal));
                if (result is not null)
                {
                    selectedDocumentIds.Add(result.DocumentId);
                    selectedAnalysisTypeIds.Add(result.AnalysisType);
                }
            }
        }

        if (selectedDocumentIds.Count > 0 && selectedAnalysisTypeIds.Count > 0)
        {
            workflowStep = WorkflowStep.Results;
        }
        else if (selectedDocumentIds.Count > 0)
        {
            workflowStep = WorkflowStep.SelectAnalysisTypes;
        }
    }

    private static IEnumerable<DocumentWithFolder> EnumerateDocuments(BulkAnalysisFolder folder)
    {
        foreach (var document in folder.Documents)
        {
            yield return new DocumentWithFolder(folder, document);
        }

        foreach (var childFolder in folder.ChildFolders)
        {
            foreach (var document in EnumerateDocuments(childFolder))
            {
                yield return document;
            }
        }
    }

    private IReadOnlyList<DocumentFolderPanel> GetFilteredDocumentPanels()
    {
        var panels = new List<DocumentFolderPanel>();

        foreach (var folder in AllFolders.OrderBy(folder => folder.DisplayName, StringComparer.OrdinalIgnoreCase))
        {
            var panel = BuildDocumentPanel(folder, depth: 0, ancestorMatched: false);
            if (panel is not null)
            {
                panels.Add(panel);
            }
        }

        return panels;
    }

    private DocumentFolderPanel? BuildDocumentPanel(BulkAnalysisFolder folder, int depth, bool ancestorMatched)
    {
        var folderMatches = ancestorMatched || MatchesFolderSearch(folder);
        var documents = folder.Documents
            .Where(document => folderMatches || MatchesDocumentSearch(document))
            .OrderBy(document => document.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        var childPanels = folder.ChildFolders
            .OrderBy(child => child.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Select(child => BuildDocumentPanel(child, depth + 1, folderMatches))
            .Where(panel => panel is not null)
            .Select(panel => panel!)
            .ToArray();

        return documents.Length == 0 && childPanels.Length == 0
            ? null
            : new DocumentFolderPanel(folder, documents, childPanels, depth);
    }

    private IReadOnlyList<DocumentFolderPanel> GetVisibleDocumentPanels()
    {
        var panels = new List<DocumentFolderPanel>();

        foreach (var panel in GetFilteredDocumentPanels())
        {
            AddVisibleDocumentPanels(panel, panels);
        }

        return panels;
    }

    private void AddVisibleDocumentPanels(DocumentFolderPanel panel, List<DocumentFolderPanel> panels)
    {
        panels.Add(panel);

        if (IsFolderCollapsed(panel.Folder.Id))
        {
            return;
        }

        foreach (var childPanel in panel.Children)
        {
            AddVisibleDocumentPanels(childPanel, panels);
        }
    }

    private bool MatchesFolderSearch(BulkAnalysisFolder folder)
    {
        if (string.IsNullOrWhiteSpace(documentSearchTerm))
        {
            return true;
        }

        return Contains(folder.DisplayName, documentSearchTerm) ||
            Contains(folder.ParentDisplayName, documentSearchTerm);
    }

    private bool MatchesDocumentSearch(BulkAnalysisDocument document)
    {
        if (string.IsNullOrWhiteSpace(documentSearchTerm))
        {
            return true;
        }

        return Contains(document.Title, documentSearchTerm) ||
            Contains(document.OriginalFileName, documentSearchTerm);
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private void HandleDocumentSearchInput(ChangeEventArgs args)
    {
        documentSearchTerm = args.Value?.ToString() ?? string.Empty;
    }

    private void ToggleDocumentSelection(string documentId)
    {
        if (!selectedDocumentIds.Add(documentId))
        {
            selectedDocumentIds.Remove(documentId);
            RemoveContextForDocument(documentId);
        }

        PruneAnalysisTypeSelection();
        EnsureSelectionPreviewTarget();
        EnsureActiveTargets();
    }

    private void ToggleFolderSelection(DocumentFolderPanel panel)
    {
        var documents = panel.VisibleDocuments;

        if (documents.Count == 0)
        {
            return;
        }

        if (GetFolderSelectionState(panel) == SelectionState.Checked)
        {
            foreach (var document in documents)
            {
                selectedDocumentIds.Remove(document.Id);
                RemoveContextForDocument(document.Id);
            }
        }
        else
        {
            foreach (var document in documents)
            {
                selectedDocumentIds.Add(document.Id);
            }
        }

        PruneAnalysisTypeSelection();
        EnsureSelectionPreviewTarget();
        EnsureActiveTargets();
    }

    private void SelectVisibleDocuments()
    {
        foreach (var document in GetVisibleDocumentPanels()
            .Where(panel => !IsFolderCollapsed(panel.Folder.Id))
            .SelectMany(panel => panel.Documents))
        {
            selectedDocumentIds.Add(document.Id);
        }

        PruneAnalysisTypeSelection();
        EnsureSelectionPreviewTarget();
        EnsureActiveTargets();
    }

    private void ClearDocumentSelection()
    {
        selectedDocumentIds.Clear();
        selectedAnalysisTypeIds.Clear();
        selectedContextIds.Clear();
        activeDocumentId = null;
        activeAnalysisType = null;
        selectionPreviewDocumentId = null;
    }

    private void ToggleAnalysisType(string analysisType)
    {
        if (!selectedAnalysisTypeIds.Add(analysisType))
        {
            selectedAnalysisTypeIds.Remove(analysisType);
            RemoveContextForAnalysisType(analysisType);
        }

        EnsureActiveTargets();
    }

    private void GoToDocumentStep()
    {
        workflowStep = WorkflowStep.SelectDocuments;
    }

    private void GoToAnalysisStep()
    {
        if (selectedDocumentIds.Count == 0)
        {
            workflowStep = WorkflowStep.SelectDocuments;
            return;
        }

        PruneAnalysisTypeSelection();
        workflowStep = WorkflowStep.SelectAnalysisTypes;
    }

    private void GoToResultsStep()
    {
        if (selectedDocumentIds.Count == 0)
        {
            workflowStep = WorkflowStep.SelectDocuments;
            return;
        }

        if (selectedAnalysisTypeIds.Count == 0)
        {
            workflowStep = WorkflowStep.SelectAnalysisTypes;
            return;
        }

        EnsureActiveTargets();
        workflowStep = WorkflowStep.Results;
    }

    private IReadOnlyList<DocumentWithFolder> GetSelectedDocuments() =>
        AllDocuments
            .Where(entry => selectedDocumentIds.Contains(entry.Document.Id))
            .OrderBy(entry => entry.Folder.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(entry => entry.Document.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<string> GetAvailableAnalysisTypes(IReadOnlyList<DocumentWithFolder> selectedDocuments) =>
        selectedDocuments
            .SelectMany(entry => entry.Document.Results)
            .Select(result => result.AnalysisType)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<string> GetSelectedAnalysisTypes(IReadOnlyList<string> availableAnalysisTypes) =>
        availableAnalysisTypes
            .Where(selectedAnalysisTypeIds.Contains)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private DocumentWithFolder? GetActiveDocument(IReadOnlyList<DocumentWithFolder> selectedDocuments) =>
        selectedDocuments.FirstOrDefault(entry => string.Equals(entry.Document.Id, activeDocumentId, StringComparison.Ordinal)) ??
        selectedDocuments.FirstOrDefault();

    private string? GetActiveAnalysisType(IReadOnlyList<string> selectedAnalysisTypes) =>
        selectedAnalysisTypes.FirstOrDefault(type => string.Equals(type, activeAnalysisType, StringComparison.OrdinalIgnoreCase)) ??
        selectedAnalysisTypes.FirstOrDefault();

    private void SetActiveDocument(string documentId)
    {
        activeDocumentId = documentId;
    }

    private void SetActiveAnalysisType(string analysisType)
    {
        activeAnalysisType = analysisType;
    }

    private void PreviousDocument()
    {
        var selectedDocuments = GetSelectedDocuments();
        if (selectedDocuments.Count == 0)
        {
            return;
        }

        var currentIndex = Math.Max(0, selectedDocuments.ToList().FindIndex(entry => string.Equals(entry.Document.Id, GetActiveDocument(selectedDocuments)?.Document.Id, StringComparison.Ordinal)));
        var nextIndex = currentIndex == 0 ? selectedDocuments.Count - 1 : currentIndex - 1;
        activeDocumentId = selectedDocuments[nextIndex].Document.Id;
    }

    private void NextDocument()
    {
        var selectedDocuments = GetSelectedDocuments();
        if (selectedDocuments.Count == 0)
        {
            return;
        }

        var currentIndex = Math.Max(0, selectedDocuments.ToList().FindIndex(entry => string.Equals(entry.Document.Id, GetActiveDocument(selectedDocuments)?.Document.Id, StringComparison.Ordinal)));
        var nextIndex = currentIndex >= selectedDocuments.Count - 1 ? 0 : currentIndex + 1;
        activeDocumentId = selectedDocuments[nextIndex].Document.Id;
    }

    private void PreviousAnalysisType()
    {
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(GetSelectedDocuments()));
        if (selectedAnalysisTypes.Count == 0)
        {
            return;
        }

        var current = GetActiveAnalysisType(selectedAnalysisTypes);
        var currentIndex = Math.Max(0, selectedAnalysisTypes.ToList().FindIndex(type => string.Equals(type, current, StringComparison.OrdinalIgnoreCase)));
        var nextIndex = currentIndex == 0 ? selectedAnalysisTypes.Count - 1 : currentIndex - 1;
        activeAnalysisType = selectedAnalysisTypes[nextIndex];
    }

    private void NextAnalysisType()
    {
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(GetSelectedDocuments()));
        if (selectedAnalysisTypes.Count == 0)
        {
            return;
        }

        var current = GetActiveAnalysisType(selectedAnalysisTypes);
        var currentIndex = Math.Max(0, selectedAnalysisTypes.ToList().FindIndex(type => string.Equals(type, current, StringComparison.OrdinalIgnoreCase)));
        var nextIndex = currentIndex >= selectedAnalysisTypes.Count - 1 ? 0 : currentIndex + 1;
        activeAnalysisType = selectedAnalysisTypes[nextIndex];
    }

    private DocumentWithFolder? GetSelectionPreviewDocument(IReadOnlyList<DocumentWithFolder> selectedDocuments) =>
        selectedDocuments.FirstOrDefault(entry => string.Equals(entry.Document.Id, selectionPreviewDocumentId, StringComparison.Ordinal)) ??
        selectedDocuments.FirstOrDefault();

    private int GetSelectionPreviewOrdinal(
        IReadOnlyList<DocumentWithFolder> selectedDocuments,
        DocumentWithFolder? selectedPreviewDocument)
    {
        if (selectedPreviewDocument is null)
        {
            return 0;
        }

        var index = selectedDocuments.ToList().FindIndex(entry => string.Equals(entry.Document.Id, selectedPreviewDocument.Document.Id, StringComparison.Ordinal));
        return index < 0 ? 1 : index + 1;
    }

    private void PreviousSelectionPreviewDocument(IReadOnlyList<DocumentWithFolder> selectedDocuments)
    {
        if (selectedDocuments.Count == 0)
        {
            return;
        }

        var currentDocument = GetSelectionPreviewDocument(selectedDocuments);
        var currentIndex = Math.Max(0, selectedDocuments.ToList().FindIndex(entry => string.Equals(entry.Document.Id, currentDocument?.Document.Id, StringComparison.Ordinal)));
        var nextIndex = currentIndex == 0 ? selectedDocuments.Count - 1 : currentIndex - 1;
        selectionPreviewDocumentId = selectedDocuments[nextIndex].Document.Id;
    }

    private void NextSelectionPreviewDocument(IReadOnlyList<DocumentWithFolder> selectedDocuments)
    {
        if (selectedDocuments.Count == 0)
        {
            return;
        }

        var currentDocument = GetSelectionPreviewDocument(selectedDocuments);
        var currentIndex = Math.Max(0, selectedDocuments.ToList().FindIndex(entry => string.Equals(entry.Document.Id, currentDocument?.Document.Id, StringComparison.Ordinal)));
        var nextIndex = currentIndex >= selectedDocuments.Count - 1 ? 0 : currentIndex + 1;
        selectionPreviewDocumentId = selectedDocuments[nextIndex].Document.Id;
    }

    private void EnsureSelectionPreviewTarget()
    {
        if (selectionPreviewDocumentId is null || !selectedDocumentIds.Contains(selectionPreviewDocumentId))
        {
            selectionPreviewDocumentId = GetSelectedDocuments().FirstOrDefault()?.Document.Id;
        }
    }

    private void EnsureActiveTargets()
    {
        var selectedDocuments = GetSelectedDocuments();
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(selectedDocuments));

        if (selectedDocuments.All(entry => !string.Equals(entry.Document.Id, activeDocumentId, StringComparison.Ordinal)))
        {
            activeDocumentId = selectedDocuments.FirstOrDefault()?.Document.Id;
        }

        if (selectedAnalysisTypes.All(type => !string.Equals(type, activeAnalysisType, StringComparison.OrdinalIgnoreCase)))
        {
            activeAnalysisType = selectedAnalysisTypes.FirstOrDefault();
        }
    }

    private void PruneAnalysisTypeSelection()
    {
        var availableAnalysisTypes = GetAvailableAnalysisTypes(GetSelectedDocuments()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        selectedAnalysisTypeIds.RemoveWhere(type => !availableAnalysisTypes.Contains(type));
        selectedContextIds.RemoveWhere(id => ShouldRemoveContextId(id, availableAnalysisTypes));
    }

    private bool ShouldRemoveContextId(string id, IReadOnlySet<string> availableAnalysisTypes)
    {
        if (id.StartsWith("doc:", StringComparison.Ordinal))
        {
            var documentId = id["doc:".Length..];
            return !selectedDocumentIds.Contains(documentId);
        }

        var result = AllResults.FirstOrDefault(result => string.Equals(result.Id, id, StringComparison.Ordinal));
        return result is null ||
            !selectedDocumentIds.Contains(result.DocumentId) ||
            !availableAnalysisTypes.Contains(result.AnalysisType);
    }

    private void RemoveContextForDocument(string documentId)
    {
        selectedContextIds.Remove(GetSourceDocumentContextId(documentId));
        selectedContextIds.RemoveWhere(id => AllResults.Any(result => string.Equals(result.Id, id, StringComparison.Ordinal) && string.Equals(result.DocumentId, documentId, StringComparison.Ordinal)));
    }

    private void RemoveContextForAnalysisType(string analysisType)
    {
        selectedContextIds.RemoveWhere(id => AllResults.Any(result => string.Equals(result.Id, id, StringComparison.Ordinal) && string.Equals(result.AnalysisType, analysisType, StringComparison.OrdinalIgnoreCase)));
    }

    private void ToggleSourceDocumentContext(BulkAnalysisFolder folder, BulkAnalysisDocument document)
    {
        ToggleContextItem(BulkAnalysisContextItem.FromSourceDocument(folder, document).Id);
    }

    private void ToggleResultContext(BulkAnalysisResult result)
    {
        ToggleContextItem(result.Id);
    }

    private void ToggleContextItem(string id)
    {
        if (!selectedContextIds.Add(id))
        {
            selectedContextIds.Remove(id);
        }
    }

    private void RemoveContextItem(string id)
    {
        selectedContextIds.Remove(id);
    }

    private IReadOnlyList<BulkAnalysisContextItem> GetSelectedContextItems()
    {
        var items = new List<BulkAnalysisContextItem>();

        foreach (var entry in AllDocuments)
        {
            var sourceItem = BulkAnalysisContextItem.FromSourceDocument(entry.Folder, entry.Document);
            if (selectedContextIds.Contains(sourceItem.Id))
            {
                items.Add(sourceItem);
            }
        }

        items.AddRange(AllResults
            .Where(result => selectedContextIds.Contains(result.Id))
            .Select(BulkAnalysisContextItem.FromResult));

        return items
            .OrderBy(item => item.FolderName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.DocumentTitle, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.Kind)
            .ThenBy(item => item.TypeLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void LoadContext()
    {
        var contextItems = GetSelectedContextItems();

        if (contextItems.Count == 0 ||
            contextItems.Sum(item => item.EstimatedTokens) > ChatContextState.ContextLimitTokens)
        {
            return;
        }

        ChatContext.Load(contextItems);
        NavigationManager.NavigateTo("/assistant-context");
    }

    private void GoToAssistantContext()
    {
        NavigationManager.NavigateTo("/assistant-context");
    }

    private static string GetSourceDocumentContextId(BulkAnalysisDocument document) =>
        GetSourceDocumentContextId(document.Id);

    private static string GetSourceDocumentContextId(string documentId) =>
        $"doc:{documentId}";

    private string GetDocumentOptionClass(string documentId) =>
        selectedDocumentIds.Contains(documentId) ? "document-option-row selected" : "document-option-row";

    private SelectionState GetFolderSelectionState(DocumentFolderPanel panel)
    {
        var documents = panel.VisibleDocuments;

        if (documents.Count == 0 || documents.All(document => !selectedDocumentIds.Contains(document.Id)))
        {
            return SelectionState.Unchecked;
        }

        return documents.All(document => selectedDocumentIds.Contains(document.Id))
            ? SelectionState.Checked
            : SelectionState.Mixed;
    }

    private static string GetFolderSelectClass(SelectionState state) =>
        state switch
        {
            SelectionState.Checked => "tri-checkbox folder-select-button checked",
            SelectionState.Mixed => "tri-checkbox folder-select-button mixed",
            _ => "tri-checkbox folder-select-button"
        };

    private static string GetAriaChecked(SelectionState state) =>
        state switch
        {
            SelectionState.Checked => "true",
            SelectionState.Mixed => "mixed",
            _ => "false"
        };

    private bool IsFolderCollapsed(string folderId) =>
        collapsedFolderIds.Contains(folderId);

    private void ToggleFolderPanel(string folderId)
    {
        if (!collapsedFolderIds.Add(folderId))
        {
            collapsedFolderIds.Remove(folderId);
        }
    }

    private string GetFolderPanelClass(DocumentFolderPanel panel)
    {
        var classes = new List<string> { "document-folder-card" };

        if (panel.Depth == 0)
        {
            classes.Add("root-folder-card");
        }

        if (IsFolderCollapsed(panel.Folder.Id))
        {
            classes.Add("collapsed");
        }

        return string.Join(' ', classes);
    }

    private string GetAnalysisOptionClass(string analysisType) =>
        selectedAnalysisTypeIds.Contains(analysisType) ? "analysis-type-option selected" : "analysis-type-option";

    private string GetContextChoiceClass(string id) =>
        selectedContextIds.Contains(id) ? "context-choice-row selected" : "context-choice-row";

    private static string GetResultTabClass(bool isActive) =>
        isActive ? "result-nav-tab active" : "result-nav-tab";

    private static string GetAnalysisGlyph(string analysisType)
    {
        if (analysisType.Contains("Summary", StringComparison.OrdinalIgnoreCase))
        {
            return "S";
        }

        if (analysisType.Contains("Risk", StringComparison.OrdinalIgnoreCase))
        {
            return "R";
        }

        if (analysisType.Contains("Compliance", StringComparison.OrdinalIgnoreCase))
        {
            return "C";
        }

        if (analysisType.Contains("Gap", StringComparison.OrdinalIgnoreCase))
        {
            return "G";
        }

        return "A";
    }

    private static string GetAnalysisDescription(string analysisType)
    {
        if (analysisType.Contains("Summary", StringComparison.OrdinalIgnoreCase))
        {
            return "Condensed operational readout for quick orientation.";
        }

        if (analysisType.Contains("Risk", StringComparison.OrdinalIgnoreCase))
        {
            return "Highlights controls, failure modes, and mitigation areas.";
        }

        if (analysisType.Contains("Compliance", StringComparison.OrdinalIgnoreCase))
        {
            return "Reviews evidence, timeliness, and regulatory alignment.";
        }

        if (analysisType.Contains("Gap", StringComparison.OrdinalIgnoreCase))
        {
            return "Identifies missing controls and process handoff gaps.";
        }

        if (analysisType.Contains("Recommendation", StringComparison.OrdinalIgnoreCase))
        {
            return "Prioritized changes for clearer document execution.";
        }

        return "Generated bulk analysis output for selected documents.";
    }

    private static string GetAnalysisTypeSummary(BulkAnalysisDocument document) =>
        document.Results.Count == 0
            ? "No generated outputs available"
            : string.Join(", ", document.Results.Select(result => result.AnalysisType).Distinct(StringComparer.OrdinalIgnoreCase));

    private static string GetOriginalDocumentContent(BulkAnalysisDocument document) =>
        MockFileData.GetContent(document.OriginalFileName, AnalysisType.Original);

    private MarkupString RenderMarkdown(BulkAnalysisResult result) =>
        new(Markdown.ToHtml(result.Markdown, MarkdownPipeline));

    private static string FormatTokens(int tokens) =>
        tokens >= 1_000 ? $"{tokens / 1_000.0:0.#}k" : tokens.ToString("N0");

    private static string FormatPercent(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void HandleChatContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatContext.Changed -= HandleChatContextChanged;
    }

    private sealed record DocumentWithFolder(BulkAnalysisFolder Folder, BulkAnalysisDocument Document);

    private sealed record DocumentFolderPanel(
        BulkAnalysisFolder Folder,
        IReadOnlyList<BulkAnalysisDocument> Documents,
        IReadOnlyList<DocumentFolderPanel> Children,
        int Depth)
    {
        public int VisibleDocumentCount => Documents.Count + Children.Sum(child => child.VisibleDocumentCount);

        public IReadOnlyList<BulkAnalysisDocument> VisibleDocuments =>
            Documents.Concat(Children.SelectMany(child => child.VisibleDocuments)).ToArray();
    }

    private enum WorkflowStep
    {
        SelectDocuments,
        SelectAnalysisTypes,
        Results
    }

    private enum SelectionState
    {
        Unchecked,
        Mixed,
        Checked
    }
}
