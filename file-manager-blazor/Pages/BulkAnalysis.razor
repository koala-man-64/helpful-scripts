        if (IsResultNodeCollapsed(panel.NodeId))
        {
            classes.Add("collapsed");
        }

        return string.Join(' ', classes);
    }

    private string GetResultCategoryPanelClass(ResultCategoryPanel panel)
    {
        var classes = new List<string> { "document-folder-card", "result-folder-card", "result-category-card" };

        if (IsResultNodeCollapsed(panel.NodeId))
        {
            classes.Add("collapsed");
        }

        return string.Join(' ', classes);
    }

    private string GetResultFileOptionClass(ResultFileItem item, bool isSelected)
    {
        var classes = new List<string> { "document-option-row", "result-document-row", "result-file-row" };

        if (isSelected)
        {
            classes.Add("selected");
        }

        if (string.Equals(item.Document.Id, activeDocumentId, StringComparison.Ordinal) &&
            string.Equals(item.Result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase))
        {
            classes.Add("active");
        }

        return string.Join(' ', classes);
    }

