{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rudy.local/codex-workflow/benchmark-evidence-receipt-v1.schema.json",
  "title": "Immutable Codex benchmark evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "manifest_digest", "run_set_digest", "results_digest", "execution_mode", "runs"],
  "properties": {
    "schema_version": {"const": "benchmark-evidence-receipt-v1"},
    "benchmark_id": {"type": "string", "pattern": "^benchmark-v1:[0-9a-f]{64}$"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "run_set_digest": {"$ref": "#/$defs/digest"},
    "results_digest": {"$ref": "#/$defs/digest"},
    "execution_mode": {"enum": ["cold", "warm"]},
    "runs": {"type": "array", "minItems": 72, "maxItems": 72, "items": {"$ref": "#/$defs/run"}}
  },
  "$defs": {
    "identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonnegative": {"type": ["number", "null"], "minimum": 0},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_task_id", "task_id", "invariant_id", "validator_id", "artifact_digest", "observation_ids", "outcome"],
      "properties": {
        "manifest_task_id": {"$ref": "#/$defs/identity"},
        "task_id": {"$ref": "#/$defs/identity"},
        "invariant_id": {"type": "string", "minLength": 1},
        "validator_id": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
        "outcome": {"enum": ["satisfied", "rejected", "unavailable"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "run_identity", "manifest_task_id", "task_id", "parent_task_id", "variant", "repetition", "adapter", "adapter_session_id", "raw_artifact_digests", "raw_artifact_refs", "completion_status", "acceptance_evidence", "metrics", "child_task_ids", "failure_artifact_digests"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "run_identity": {"$ref": "#/$defs/identity"},
        "manifest_task_id": {"$ref": "#/$defs/identity"},
        "task_id": {"$ref": "#/$defs/identity"},
        "parent_task_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "variant": {"enum": ["baseline", "candidate"]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
        "adapter": {"const": "codex-cli-exec-v1"},
        "adapter_session_id": {"type": "string", "minLength": 1},
        "raw_artifact_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
        "raw_artifact_refs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}}},
        "completion_status": {"const": "completed"},
        "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost_usd", "uncached_input_tokens", "rework_count", "avoidable_interventions", "active_seconds", "lost_continuations", "duplicate_continuations", "load_bearing_retention"],
          "properties": {
            "cost_usd": {"$ref": "#/$defs/nonnegative"},
            "uncached_input_tokens": {"$ref": "#/$defs/nonnegative"},
            "rework_count": {"$ref": "#/$defs/nonnegative"},
            "avoidable_interventions": {"$ref": "#/$defs/nonnegative"},
            "active_seconds": {"$ref": "#/$defs/nonnegative"},
            "lost_continuations": {"type": "integer", "minimum": 0},
            "duplicate_continuations": {"type": "integer", "minimum": 0},
            "load_bearing_retention": {"type": "integer", "minimum": 0, "maximum": 1}
          }
        },
        "child_task_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
        "failure_artifact_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
