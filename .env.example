# Discover login
DISCOVER_USERNAME=your_discover_username
DISCOVER_PASSWORD=your_discover_password

# ADLS upload target
ADLS_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
ADLS_FILE_SYSTEM=your_container
ADLS_DIRECTORY=optional/subfolder
ADLS_TARGET_FILENAME=optional-fixed-name.csv

# MCP chatbot server (mcp-chatbot/) - Azure AI Foundry
FOUNDRY_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1/
FOUNDRY_API_KEY=your_foundry_api_key
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_DEFAULT_DEPLOYMENT=your-deployment-name
FOUNDRY_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
FOUNDRY_TIMEOUT_SECONDS=
MCP_CHATBOT_DATA_DIR=

# ServiceNow client (servicenow-client/)
SERVICENOW_INSTANCE=your-instance-name-or-full-https-url
SERVICENOW_USERNAME=your_service_account
SERVICENOW_PASSWORD=your_service_account_password
SERVICENOW_TIMEOUT_SECONDS=
SERVICENOW_READ_ONLY=
SERVICENOW_ALLOW_DELETE=
SERVICENOW_MAX_ATTACHMENT_MB=
# Reserved for OAuth support (not yet implemented):
# SERVICENOW_AUTH=oauth
# SERVICENOW_CLIENT_ID=
# SERVICENOW_CLIENT_SECRET=
# SERVICENOW_REFRESH_TOKEN=

# edgepy - Python inside Edge (edge-pyodide/); all optional, read from real env vars only
EDGEPY_VENDOR_DIR=
EDGEPY_EDGE_PATH=
EDGEPY_RUN_DIR=
EDGEPY_TIMEOUT_SECONDS=
EDGEPY_SHOW=
EDGEPY_PYODIDE_VERSION=
EDGEPY_CA_BUNDLE=
