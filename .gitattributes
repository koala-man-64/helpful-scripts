# Normalize line endings to prevent repo-wide CRLF/LF churn.
# Text files are stored with LF in the repo and checked out with LF.
* text=auto eol=lf

# Treat common binary assets as binary (never normalized).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
*.pptx binary

# Published evidence fixtures and receipts are retained byte-for-byte.
codex-workflow/benchmark/contracts/benchmark-host-census-v1/** -text
