    private void EnsureActiveTargets()
    {
        var selectedDocuments = GetSelectedDocuments();
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(selectedDocuments));

        if (selectedDocuments.All(entry => !string.Equals(entry.Document.Id, activeDocumentId, StringComparison.Ordinal)))
        {
            activeDocumentId = selectedDocuments.FirstOrDefault()?.Document.Id;
        }

        if (selectedAnalysisTypes.All(type => !string.Equals(type, activeAnalysisType, StringComparison.OrdinalIgnoreCase)))
        {
            activeAnalysisType = selectedAnalysisTypes.FirstOrDefault();
        }
    }

    private void PruneAnalysisTypeSelection()
    {
        var availableAnalysisTypes = GetAvailableAnalysisTypes(GetSelectedDocuments()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        selectedAnalysisTypeIds.RemoveWhere(type => !availableAnalysisTypes.Contains(type));
        selectedResultIds.RemoveWhere(id => ShouldRemoveResultId(id, availableAnalysisTypes));
    }

    private bool ShouldRemoveResultId(string id, IReadOnlySet<string> availableAnalysisTypes)
    {
        var result = AllResults.FirstOrDefault(result => string.Equals(result.Id, id, StringComparison.Ordinal));
        return result is null ||
            !selectedDocumentIds.Contains(result.DocumentId) ||
            !availableAnalysisTypes.Contains(result.AnalysisType);
    }

    private void RemoveResultsForDocument(string documentId)
    {
        selectedResultIds.RemoveWhere(id => AllResults.Any(result => string.Equals(result.Id, id, StringComparison.Ordinal) && string.Equals(result.DocumentId, documentId, StringComparison.Ordinal)));
    }

    private void RemoveResultsForAnalysisType(string analysisType)
    {
        selectedResultIds.RemoveWhere(id => AllResults.Any(result => string.Equals(result.Id, id, StringComparison.Ordinal) && string.Equals(result.AnalysisType, analysisType, StringComparison.OrdinalIgnoreCase)));
    }

    private IReadOnlyList<BulkAnalysisResult> GetSelectedDownloadResults() =>
        AllResults
            .Where(result => selectedResultIds.Contains(result.Id))
            .OrderBy(result => result.FolderName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(result => result.DocumentTitle, StringComparer.OrdinalIgnoreCase)
            .ThenBy(result => result.AnalysisType, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private async Task DownloadSelectedResults()
    {
        var results = GetSelectedDownloadResults();
        if (results.Count == 0 || isDownloadingResults)
        {
            return;
        }

        isDownloadingResults = true;
        downloadErrorMessage = null;

        try
        {
            var markdownByResultId = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var result in results)
            {
                markdownByResultId[result.Id] = await GetOrLoadResultMarkdownAsync(result);
            }

            await JSRuntime.InvokeVoidAsync(
                "bulkAnalysisDownloads.downloadBinaryFile",
                GetResultsZipFileName(results),
                BuildResultsZipArchive(results, markdownByResultId),
                "application/zip");
        }
        catch (Exception ex)
        {
            downloadErrorMessage = ex.Message;
        }
        finally
        {
            isDownloadingResults = false;
        }
    }

    private static byte[] BuildResultsZipArchive(
        IReadOnlyList<BulkAnalysisResult> results,
        IReadOnlyDictionary<string, string> markdownByResultId)
    {
        var downloadedAt = DateTime.Now;
        using var stream = new MemoryStream();

        using (var archive = new ZipArchive(stream, ZipArchiveMode.Create, leaveOpen: true))
        {
            var usedEntryNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var result in results)
            {
                var entry = archive.CreateEntry(GetResultZipEntryName(result, usedEntryNames), CompressionLevel.Optimal);

                using var entryStream = entry.Open();
                using var writer = new StreamWriter(entryStream, new UTF8Encoding(encoderShouldEmitUTF8Identifier: false));
                writer.Write(BuildResultDownloadMarkdown(result, markdownByResultId[result.Id], downloadedAt));
            }
        }

        return stream.ToArray();
    }

    private static string BuildResultDownloadMarkdown(BulkAnalysisResult result, string markdown, DateTime downloadedAt)
    {
        var builder = new StringBuilder();

        builder
            .AppendLine($"# {result.DocumentTitle} - {result.AnalysisType}")
            .AppendLine()
            .AppendLine($"- Folder: {result.FolderName}")
            .AppendLine($"- Source file: {result.OriginalFileName}")
            .AppendLine($"- Generated: {result.GeneratedAt:MMM d, yyyy h:mm tt}")
            .AppendLine($"- Downloaded: {downloadedAt:MMM d, yyyy h:mm tt}")
            .AppendLine($"- Estimated tokens: {FormatTokens(EstimateTokens(markdown))}")
            .AppendLine()
            .AppendLine(markdown.Trim());

        return builder.ToString().TrimEnd() + Environment.NewLine;
    }

    private static string GetResultsZipFileName(IReadOnlyList<BulkAnalysisResult> results)
    {
        var name = results.Count == 1
            ? $"{results[0].DocumentTitle}-{results[0].AnalysisType}"
            : $"bulk-analysis-results-{DateTime.Now:yyyyMMdd-HHmmss}";

        return $"{SlugifyFileName(name)}.zip";
    }

    private static string GetResultZipEntryName(BulkAnalysisResult result, ISet<string> usedEntryNames)
    {
        var folderName = SlugifyFileName(result.FolderName);
        var documentName = SlugifyFileName(result.DocumentTitle);
        var fileName = SlugifyFileName($"{result.OriginalFileName}-{result.AnalysisType}");
        var directoryName = $"{folderName}/{documentName}";
        var entryName = $"{directoryName}/{fileName}.md";
        var suffix = 2;

        while (!usedEntryNames.Add(entryName))
        {
            entryName = $"{directoryName}/{fileName}-{suffix}.md";
            suffix++;
        }

        return entryName;
    }

    private static string SlugifyFileName(string value)
    {
        var builder = new System.Text.StringBuilder(value.Length);
        var lastWasSeparator = false;

        foreach (var character in value.Trim().ToLowerInvariant())
        {
            if (character is >= 'a' and <= 'z' or >= '0' and <= '9')
            {
                builder.Append(character);
                lastWasSeparator = false;
            }
            else if (!lastWasSeparator)
            {
                builder.Append('-');
                lastWasSeparator = true;
            }
        }

        var slug = builder.ToString().Trim('-');
        return string.IsNullOrWhiteSpace(slug) ? "bulk-analysis-results" : slug;
    }

