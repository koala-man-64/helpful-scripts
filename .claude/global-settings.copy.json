      "Bash(gh *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(.venv/*)",
      "Bash(./node_modules/*)",
      "Bash(az *)",
      "Bash(curl *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(xargs *)",
      "Bash(cp *)",
      "Bash(mkdir *)",
      "Bash(diff *)",
      "Bash(comm *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(py *)",
      "Bash(cd *)",
      "Bash(set *)",
      "Bash(for *)",
      "Bash(test *)",
      "Bash(Select-String *)",
      "Bash(Select-Object *)",
      "Bash(Head *)",
      "Bash(DISABLE_DOTENV=1 *)",
      "PowerShell(*)",
      "Read(//c/Users/rdpro/**)",
      "Read(//tmp/**)",
      "Edit(//c/Users/rdpro/.claude/**)",
      "Edit(//c/Users/rdpro/Projects/**)",
      "Write(//c/Users/rdpro/AppData/Local/Temp/**)",
      "Write(//tmp/**)",
      "Skill(update-config)",
      "Skill(update-config:*)"
    ],
    "additionalDirectories": [
      "C:\\Users\\rdpro\\AppData\\Local\\Temp",
      "\\tmp",
      "C:\\Users\\rdpro\\.claude",
      "C:\\Users\\rdpro\\Projects"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Deleting Azure Container Apps and Container Apps Jobs via `az containerapp delete` or `az containerapp job delete` when --resource-group is AssetAllocationRG. These are recreated by the deployment pipelines and are part of the approved private-environment migration (legacy app retirement and moving jobs between managed environments, which Azure cannot do in place)."
    ]
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "C:\\Users\\rdpro\\.claude\\hooks\\session_start_team_context.py"
            ],
            "timeout": 10,
            "statusMessage": "Loading team workflow context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "C:\\Users\\rdpro\\.claude\\hooks\\user_prompt_submit_router.py"
            ],
            "timeout": 10,
            "statusMessage": "Routing request through team workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "C:\\Users\\rdpro\\.claude\\hooks\\pre_tool_use_bash_guard.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking shell safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "C:\\Users\\rdpro\\.claude\\hooks\\stop_team_closeout.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking team closeout"
          },
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "C:\\Users\\rdpro\\.claude\\hooks\\stop_gateway_bookkeeper_recap.py"
            ],
            "timeout": 10,
            "statusMessage": "Checking gateway bookkeeper recap"
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true
}