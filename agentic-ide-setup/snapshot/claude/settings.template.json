  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\session_start_team_context.py\"",
            "timeout": 10,
            "statusMessage": "Loading team workflow context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\user_prompt_submit_router.py\"",
            "timeout": 10,
            "statusMessage": "Routing request through team workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\pre_tool_use_bash_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking shell safety"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\pre_tool_use_agent_ladder.py\"",
            "timeout": 10,
            "statusMessage": "Checking subagent model ladder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\post_tool_use_wait_detector.py\"",
            "timeout": 10,
            "statusMessage": "Checking for delivery waits"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"__USERPROFILE__\\.claude\\hooks-release\\agentic-ide-setup\\profile\\claude\\hooks\\stop_team_closeout.py\"",
            "timeout": 10,
            "statusMessage": "Checking team closeout"
          }
        ]
      }
    ],
    "SubagentStart": [],
    "SubagentStop": [],
    "SessionEnd": []
  },
  "statusLine": {
    "type": "command",
    "command": "py \"__USERPROFILE__\\Projects\\quota-burndown\\quota-burndown.py\" statusline",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "quota-burndown@rudy-local": true
  },
  "extraKnownMarketplaces": {
    "rudy-local": {
      "source": {
        "source": "directory",
        "path": "__USERPROFILE__\\Projects\\quota-burndown"
      }
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
