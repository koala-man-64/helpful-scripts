ed.id --relation-type parent --target-id 221 | Out-Null;\n  $updated = az boards work-item update --id $created.id --state Active --fields \"Microsoft.VSTS.Common.StackRank=$($task.Rank)\" \"System.Tags=codex; repo:$($task.Repo); trading-agents; skill-hygiene\" | ConvertFrom-Json;\n  $results += [pscustomobject]@{ repo = $task.Repo; id = $updated.id; state = $updated.fields.'System.State'; rank = $updated.fields.'Microsoft.VSTS.Common.StackRank' };\n}\n$results | ConvertTo-Json -Depth 5"], decision="allow")
