    private async Task RenderSelectedSourcePreviewAsync()
    {
        var previewDocument = workflowStep == WorkflowStep.SelectDocuments
            ? GetSelectionPreviewDocument(GetSelectedDocuments())
            : null;
        var previewDocumentId = previewDocument?.Document.Id;

        if (string.Equals(previewDocumentId, renderedSourcePreviewDocumentId, StringComparison.Ordinal))
        {
            return;
        }

        renderedSourcePreviewDocumentId = previewDocumentId;
        rawPreviewError = null;

        if (previewDocumentId is null)
        {
            return;
        }

        try
        {
            var rawFile = await ResultProvider.GetRawFileAsync(previewDocumentId);
            if (rawFile is null)
            {
                rawPreviewError = "The selected raw file could not be found in the provider catalog.";
                await JSRuntime.InvokeVoidAsync("bulkAnalysisPreview.clear", sourcePreviewHost);
                StateHasChanged();
                return;
            }

            await JSRuntime.InvokeVoidAsync(
                "bulkAnalysisPreview.render",
                sourcePreviewHost,
                rawFile.FileName,
                rawFile.ContentType,
                rawFile.Content);
        }
        catch (Exception ex)
        {
            rawPreviewError = ex.Message;
            await JSRuntime.InvokeVoidAsync("bulkAnalysisPreview.clear", sourcePreviewHost);
            StateHasChanged();
        }
    }

    private string? GetResultMarkdown(BulkAnalysisResult result)
    {
        if (resultMarkdownById.TryGetValue(result.Id, out var markdown))
        {
            return markdown;
        }

        return string.IsNullOrWhiteSpace(result.Markdown) ? null : result.Markdown;
    }

    private string? GetResultMarkdownError(BulkAnalysisResult result) =>
        resultMarkdownErrorsById.GetValueOrDefault(result.Id);

    private async Task<string> GetOrLoadResultMarkdownAsync(BulkAnalysisResult result)
    {
        var existingMarkdown = GetResultMarkdown(result);
        if (existingMarkdown is not null)
        {
            return existingMarkdown;
        }

        var markdown = await ResultProvider.GetResultMarkdownAsync(result.Id)
            ?? throw new InvalidOperationException($"The selected {result.AnalysisType} result could not be found in ADLS.");

        resultMarkdownById[result.Id] = markdown;
        resultMarkdownErrorsById.Remove(result.Id);
        return markdown;
    }

    private async Task LoadActiveResultMarkdownAsync()
    {
        if (workflowStep != WorkflowStep.Results)
        {
            return;
        }

        var selectedDocuments = GetSelectedDocuments();
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(selectedDocuments));
        var activeDocument = GetActiveDocument(selectedDocuments);
        var activeAnalysisType = GetActiveAnalysisType(selectedAnalysisTypes);
        var activeResult = activeDocument is null || activeAnalysisType is null
            ? null
            : activeDocument.Document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase));

        if (activeResult is null ||
            !activeResult.IsPreviewAvailable ||
            GetResultMarkdown(activeResult) is not null ||
            resultMarkdownErrorsById.ContainsKey(activeResult.Id) ||
            string.Equals(loadingResultId, activeResult.Id, StringComparison.Ordinal))
        {
            return;
        }

        loadingResultId = activeResult.Id;
        await InvokeAsync(StateHasChanged);

        try
        {
            await GetOrLoadResultMarkdownAsync(activeResult);
        }
        catch (Exception ex)
        {
            resultMarkdownErrorsById[activeResult.Id] = ex.Message;
        }
        finally
        {
            if (string.Equals(loadingResultId, activeResult.Id, StringComparison.Ordinal))
            {
                loadingResultId = null;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static MarkupString RenderMarkdown(string markdown) =>
        new(Markdown.ToHtml(markdown, MarkdownPipeline));

    private static string GetFolderPath(BulkAnalysisFolder folder) =>
        string.IsNullOrWhiteSpace(folder.ParentDisplayName)
            ? folder.DisplayName
            : $"{folder.ParentDisplayName} / {folder.DisplayName}";

    private static int EstimateTokens(string markdown) =>
        (int)Math.Ceiling(markdown.Length / 4.0);

    private static string FormatTokens(int tokens) =>
        tokens >= 1_000 ? $"{tokens / 1_000.0:0.#}k" : tokens.ToString("N0");

    private sealed record DocumentWithFolder(BulkAnalysisFolder Folder, BulkAnalysisDocument Document);

    private sealed record DocumentFolderPanel(
        BulkAnalysisFolder Folder,
        IReadOnlyList<BulkAnalysisDocument> Documents,
        IReadOnlyList<DocumentFolderPanel> Children,
        int Depth)
    {
        public int VisibleDocumentCount => Documents.Count + Children.Sum(child => child.VisibleDocumentCount);

        public IReadOnlyList<BulkAnalysisDocument> VisibleDocuments =>
            Documents.Concat(Children.SelectMany(child => child.VisibleDocuments)).ToArray();
    }

    private enum WorkflowStep
    {
        SelectDocuments,
        SelectAnalysisTypes,
        Results
    }

    private enum SelectionState
    {
        Unchecked,
        Mixed,
        Checked
    }
}
