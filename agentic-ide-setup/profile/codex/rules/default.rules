prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$tasks = @(\n  @{ Repo='asset-allocation-contracts'; Title='[asset-allocation-contracts] Propagate trading-agent skill rationalization'; Rank='1180000' },\n  @{ Repo='asset-allocation-control-plane'; Title='[asset-allocation-control-plane] Propagate trading-agent skill rationalization'; Rank='1181000' },\n  @{ Repo='asset-allocation-jobs'; Title='[asset-allocation-jobs] Propagate trading-agent skill rationalization'; Rank='1182000' },\n  @{ Repo='asset-allocation-runtime-common'; Title='[asset-allocation-runtime-common] Propagate trading-agent skill rationalization'; Rank='1183000' }\n);\nforeach ($task in $tasks) {\n  $desc = \"<div><strong>Objective</strong>: Propagate the approved trading-agent rationalization from asset-allocation-ui into $($task.Repo), removing the umbrella reviewer and aligning router, skill, and Claude surfaces.</div><div><strong>Agent roles to use:</strong><ul><li>delivery-orchestrator-agent</li><li>gateway-bookkeeper</li><li>delivery-engineer-agent</li><li>qa-release-gate-agent</li><li>git-hygiene-orchestrator</li></ul></div><div><strong>Repos to use:</strong><ul><li>$($task.Repo)</li></ul></div><div><strong>Implementation boundary</strong>: Local-only skill, router, mirror, and verification updates in $($task.Repo). No shared contract or payload changes.</div><div><strong>Acceptance notes</strong>:<ul><li>senior-trading-desk-reviewer is removed from supported skill and mirror surfaces.</li><li>Specialist routing replaces the broad trading-model-risk lane.</li><li>Surviving skill references are rewired consistently with the approved UI implementation.</li></ul></div>\";\n  $created = az boards work-item create --type Task --title $task.Title --area AdaptiveAssetAllocation --iteration AdaptiveAssetAllocation --assigned-to rdprokes@gmail.com --description $desc | ConvertFrom-Json;\n  az boards work-item relation add --id $created.id --relation-type parent --target-id 221 | Out-Null;\n  $updated = az boards work-item update --id $created.id --state Active --fields \"Microsoft.VSTS.Common.StackRank=$($task.Rank)\" \"System.Tags=codex; repo:$($task.Repo); trading-agents; skill-hygiene\" | ConvertFrom-Json;\n  [pscustomobject]@{ repo = $task.Repo; id = $updated.id; state = $updated.fields.'System.State'; rank = $updated.fields.'Microsoft.VSTS.Common.StackRank' }\n} | ConvertTo-Json -Depth 5"], decision="allow")
