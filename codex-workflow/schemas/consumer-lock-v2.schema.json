{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "lane",
    "active_surface_skill_pins",
    "lane_required_skill_ids",
    "task_participant_skill_ids",
    "unresolved_forks",
    "central_denials",
    "record_authority",
    "selected_routing_policy",
    "lane_execution_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "consumer-lock-v2"
    },
    "repository": {
      "enum": ["asset-allocation-contracts", "asset-allocation-control-plane", "asset-allocation-jobs", "asset-allocation-runtime-common", "asset-allocation-ui"]
    },
    "lane": {
      "enum": [
        "lite",
        "standard",
        "critical"
      ]
    },
    "active_surface_skill_pins": {
      "type": "array",
      "minItems": 10,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "content_hash", "content_hash_algorithm", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "source": {"type": "object"},
          "content_hash": {"type": "string"},
          "content_hash_algorithm": {"enum": ["git-tree-sha1", "sha256"]},
          "version": {"type": "string"}
        }
      }
    },
    "lane_required_skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
    },
    "task_participant_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_forks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runnable", "selection_blocked"],
        "properties": {"id": {"type": "string"}, "runnable": {"const": false}, "selection_blocked": {"const": true}}
      }
    },
    "central_denials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "record_authority": {"type": "object", "additionalProperties": false, "required": ["mutation_evidence", "tracked_delivery", "coordination_ledger", "jsonl"], "properties": {"mutation_evidence": {"const": "central_hooks"}, "tracked_delivery": {"const": "azure_boards_when_applicable"}, "coordination_ledger": {"const": "none_by_default"}, "jsonl": {"const": "regulated_audit_only_when_explicitly_required"}}},
    "selected_routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort", "role"],
      "properties": {"model": {"enum": ["Luna", "Terra", "Sol"]}, "effort": {"enum": ["low", "medium", "high"]}, "role": {"type": "string"}}
    },
    "lane_execution_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "children", "minimum_children", "maximum_children", "orchestrator", "gate_owners"],
      "properties": {
        "owner": {"type": "object"},
        "children": {"type": "array"},
        "minimum_children": {"type": "integer", "minimum": 0},
        "maximum_children": {"type": "integer", "minimum": 0},
        "orchestrator": {"type": "boolean"},
        "gate_owners": {"type": "object"}
      }
    }
  }
}
