# Discover login
DISCOVER_USERNAME=your_discover_username
DISCOVER_PASSWORD=your_discover_password

# ADLS upload target
ADLS_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
ADLS_FILE_SYSTEM=your_container
ADLS_DIRECTORY=optional/subfolder
ADLS_TARGET_FILENAME=optional-fixed-name.csv
