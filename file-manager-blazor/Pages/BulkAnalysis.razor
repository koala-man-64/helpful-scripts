@page "/bulk-analysis"
@using Markdig
@implements IDisposable
@inject IBulkAnalysisResultProvider ResultProvider
@inject ChatContextState ChatContext
@inject NavigationManager NavigationManager

@{
    var filteredGroups = GetFilteredGroups();
    var visibleResultIds = filteredGroups.SelectMany(folder => folder.Results).Select(result => result.Id).ToHashSet(StringComparer.Ordinal);
    var selectedResults = GetSelectedResults();
    var selectedTokens = selectedResults.Sum(result => result.EstimatedTokens);
    var isOverLimit = selectedTokens > ChatContextState.ContextLimitTokens;
    var usagePercent = Math.Min(100, selectedTokens * 100.0 / ChatContextState.ContextLimitTokens);
    var hiddenSelectedCount = selectedResultIds.Count(id => !visibleResultIds.Contains(id));
    var previewResult = GetPreviewResult();
    var filterChips = GetActiveFilterChips();
}

<PageTitle>Bulk Analysis</PageTitle>

<header class="page-header bulk-page-header">
    <p class="page-kicker">Context builder</p>
    <div class="page-header-copy">
        <div>
            <h1>Bulk Analysis</h1>
            <p>Select SOP analysis results and load them into chat context.</p>
        </div>
        <div class="page-header-meta">
            <span class="meta-pill">@AllResults.Count results</span>
            <span class="meta-pill">@AllFolders.Sum(folder => folder.SopCount) SOPs</span>
        </div>
    </div>
</header>

<section class="bulk-analysis-page" aria-label="Bulk Analysis workspace">
    <section class="filter-scope-card" aria-label="Filter and scope">
        <div class="bulk-card-title-row">
            <div>
                <h2>Filter &amp; Scope</h2>
                @if (!isFilterPanelExpanded)
                {
                    <p>@(filterChips.Count == 0 ? "No filters applied" : $"{filterChips.Count} filters applied")</p>
                }
            </div>
            <div class="bulk-card-actions">
                @if (!isFilterPanelExpanded && filterChips.Count > 0)
                {
                    <button type="button" class="link-button" @onclick="ClearFilters">Clear Filters</button>
                }
                <button type="button" class="secondary-button" @onclick="ToggleFilters">
                    @(isFilterPanelExpanded ? "Collapse" : "Show Filters")
                </button>
            </div>
        </div>

        @if (isFilterPanelExpanded)
        {
            <div class="filter-grid">
                <label class="form-control search-box">
                    <span class="control-label">Search</span>
                    <input type="search"
                           placeholder="Search SOPs, folders, or analysis results..."
                           value="@searchTerm"
                           @oninput="HandleSearchInput"
                           data-testid="bulk-search" />
                </label>

                <label class="form-control">
                    <span class="control-label">Analysis Type</span>
                    <select value="@analysisTypeFilter" @onchange="HandleAnalysisTypeChange" data-testid="analysis-type-filter">
                        <option value="">All analysis types</option>
                        @foreach (var type in AnalysisTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </label>

                <label class="form-control">
                    <span class="control-label">Sort</span>
                    <select value="@sortMode" @onchange="HandleSortChange" data-testid="bulk-sort">
                        <option value="recent">Recent first</option>
                        <option value="sop">SOP name</option>
                        <option value="folder">Folder</option>
                        <option value="analysis">Analysis type</option>
                    </select>
                </label>

                <div class="form-control filter-actions">
                    <span class="control-label">Actions</span>
                    <div class="inline-actions">
                        <button type="button" class="secondary-button" @onclick="RefreshAsync">Refresh</button>
                        <button type="button" class="secondary-button" @onclick="ClearFilters">Clear Filters</button>
                    </div>
                </div>
            </div>

            <div class="folder-filter-panel" aria-label="Folders">
                <div class="control-label">Folders</div>
                <div class="folder-filter-list">
                    @foreach (var folder in AllFolders)
                    {
                        <label class="folder-filter-option">
                            <input type="checkbox"
                                   checked="@selectedFilterFolderIds.Contains(folder.Id)"
                                   @onchange="() => ToggleFolderFilter(folder.Id)" />
                            <span>
                                <strong>@folder.DisplayName</strong>
                                @if (!string.IsNullOrWhiteSpace(folder.ParentDisplayName))
                                {
                                    <small>@folder.ParentDisplayName</small>
                                }
                            </span>
                            <em>@folder.SopCount SOPs - @folder.ResultCount analyses</em>
                        </label>
                    }
                </div>
            </div>
        }
        else if (filterChips.Count > 0)
        {
            <div class="filter-chip-row" aria-label="Active filters">
                @foreach (var chip in filterChips)
                {
                    <span class="context-chip">@chip</span>
                }
            </div>
        }
    </section>

    <section class="@($"selected-context-card {(isOverLimit ? "over-limit" : "")}")" aria-label="Selected Context" data-testid="selected-context-card">
        <div class="bulk-card-title-row">
            <div>
                <h2>Selected Context</h2>
                @if (selectedResults.Count == 0)
                {
                    <p>No analysis results selected yet</p>
                }
                else
                {
                    <p>@($"{selectedResults.Count} results selected - {FormatTokens(selectedTokens)} / {FormatTokens(ChatContextState.ContextLimitTokens)} context used")</p>
                }
            </div>
            <div class="bulk-card-actions">
                <button type="button" class="secondary-button" disabled="@(selectedResults.Count == 0)" @onclick="ClearSelection">Clear Selection</button>
                <button type="button" class="secondary-button" disabled="@(selectedResults.Count == 0)" @onclick="ReviewSelected">Review Selected</button>
                <button type="button"
                        class="send-button"
                        disabled="@(selectedResults.Count == 0 || isOverLimit)"
                        @onclick="LoadContext"
                        data-testid="load-chat-context">
                    @(HasDirtyLoadedContext ? "Update Chat Context" : "Load into Chat Context")
                </button>
                @if (ChatContext.HasLoadedContext)
                {
                    <button type="button" class="secondary-button" @onclick="GoToChat" data-testid="go-to-chat">Go to Chat</button>
                    <button type="button" class="secondary-button" @onclick="ClearLoadedContext">Clear Loaded Context</button>
                }
            </div>
        </div>

        <div class="context-meter" aria-label="Context usage">
            <span style="@($"width: {FormatPercent(usagePercent)}%;")"></span>
        </div>

        @if (selectedResults.Count == 0)
        {
            <p class="muted-copy">Select one or more SOP analysis results below to load them into chat context.</p>
        }
        else
        {
            <div class="selected-chip-list" aria-label="Selected analysis results">
                @foreach (var result in selectedResults)
                {
                    <span class="selected-chip">
                        @result.SopTitle - @result.AnalysisType
                        <button type="button" @onclick="() => RemoveSelected(result.Id)" aria-label="@($"Remove {result.SopTitle} {result.AnalysisType}")">x</button>
                    </span>
                }
            </div>
        }

        @if (hiddenSelectedCount > 0)
        {
            <p class="inline-notice">@hiddenSelectedCount selected result@(hiddenSelectedCount == 1 ? " is" : "s are") hidden by the current filters.</p>
        }

        @if (isOverLimit)
        {
            <p class="inline-warning">Too much content selected. Remove one or more analysis results before loading them into chat context.</p>
        }
        else if (!string.IsNullOrWhiteSpace(selectionWarning))
        {
            <p class="inline-warning">@selectionWarning</p>
        }

        @if (ChatContext.HasLoadedContext && !HasDirtyLoadedContext)
        {
            <p class="inline-success">Context loaded. @ChatContext.LoadedItems.Count SOP analysis result@(ChatContext.LoadedItems.Count == 1 ? "" : "s") ready to use in chat.</p>
        }
        else if (HasDirtyLoadedContext)
        {
            <p class="inline-notice">Selection changed. Update chat context to use the latest selected results.</p>
        }
    </section>

    <section class="bulk-workspace" aria-label="Bulk Analysis results and preview">
        <section class="result-list-card" aria-label="SOP Analysis Results">
            <div class="bulk-card-title-row">
                <div>
                    <h2>SOP Analysis Results</h2>
                    <p>Folder - SOP - Analysis Result</p>
                </div>
                <span class="selected-count">@filteredGroups.Sum(folder => folder.Results.Count) visible</span>
            </div>

            @if (filteredGroups.Count == 0)
            {
                <div class="bulk-empty-state">
                    <strong>No matching analysis results</strong>
                    <span>Clear filters or search for a different SOP, folder, or analysis type.</span>
                </div>
            }
            else
            {
                <div class="bulk-result-list">
                    @foreach (var folderGroup in filteredGroups)
                    {
                        var folderResults = folderGroup.Results.ToArray();
                        var folderState = GetSelectionState(folderResults.Select(result => result.Id));
                        var folderWouldExceed = folderState != SelectionState.Checked && WouldGroupSelectionExceedLimit(folderResults);

                        <section class="bulk-folder-group">
                            <header class="bulk-group-header">
                                <button type="button"
                                        class="@GetTriStateClass(folderState)"
                                        role="checkbox"
                                        aria-checked="@GetAriaChecked(folderState)"
                                        disabled="@folderWouldExceed"
                                        @onclick="() => ToggleFolder(folderGroup)"
                                        aria-label="@($"Select visible results in {folderGroup.Folder.DisplayName}")"></button>
                                <div>
                                    <h3>@folderGroup.Folder.DisplayName</h3>
                                    <p>@($"{folderGroup.Sops.Count} SOPs - {folderResults.Length} analyses - {folderResults.Count(result => selectedResultIds.Contains(result.Id))} selected - {FormatTokens(folderResults.Sum(result => result.EstimatedTokens))} estimated tokens")</p>
                                    @if (folderWouldExceed)
                                    {
                                        <span class="group-warning">Selecting this folder would exceed the context limit.</span>
                                    }
                                </div>
                            </header>

                            @foreach (var sopGroup in folderGroup.Sops)
                            {
                                var sopResults = sopGroup.Results.ToArray();
                                var sopState = GetSelectionState(sopResults.Select(result => result.Id));
                                var sopWouldExceed = sopState != SelectionState.Checked && WouldGroupSelectionExceedLimit(sopResults);

                                <section class="bulk-sop-group">
                                    <header class="bulk-sop-header">
                                        <button type="button"
                                                class="@GetTriStateClass(sopState)"
                                                role="checkbox"
                                                aria-checked="@GetAriaChecked(sopState)"
                                                disabled="@sopWouldExceed"
                                                @onclick="() => ToggleSop(sopGroup)"
                                                aria-label="@($"Select visible results for {sopGroup.Sop.Title}")"></button>
                                        <div>
                                            <h4>@sopGroup.Sop.Title</h4>
                                            <p>@($"{sopGroup.Sop.OriginalFileName} - {sopResults.Length} analyses")</p>
                                            @if (sopWouldExceed)
                                            {
                                                <span class="group-warning">Selecting this SOP would exceed the context limit.</span>
                                            }
                                        </div>
                                    </header>

                                    <div class="bulk-row-list">
                                        @foreach (var result in sopResults)
                                        {
                                            <article class="@GetResultRowClass(result)" data-testid="@($"bulk-result-{result.Id}")">
                                                <input type="checkbox"
                                                       checked="@selectedResultIds.Contains(result.Id)"
                                                       @onchange="() => ToggleResult(result.Id)"
                                                       aria-label="@($"Select {result.SopTitle} {result.AnalysisType}")" />
                                                <button type="button" class="bulk-row-title" @onclick="() => PreviewResult(result)">
                                                    <strong>@result.AnalysisType</strong>
                                                    <span>@result.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
                                                </button>
                                                <span class="row-token-pill">@FormatTokens(result.EstimatedTokens)</span>
                                            </article>
                                        }
                                    </div>
                                </section>
                            }
                        </section>
                    }
                </div>
            }
        </section>

        <section class="preview-card" aria-label="Preview">
            @if (previewResult is null)
            {
                <div class="bulk-empty-state preview-empty">
                    <strong>Select an analysis result to preview its contents.</strong>
                    <span>Choose Review Selected to step through your selected context.</span>
                </div>
            }
            else
            {
                <header class="preview-header">
                    <div>
                        <p class="page-kicker">Preview</p>
                        <h2>@previewResult.SopTitle</h2>
                        <p>@previewResult.FolderName - @previewResult.AnalysisType - @previewResult.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</p>
                    </div>
                    <div class="preview-actions">
                        @if (isReviewMode && selectedResults.Count > 0)
                        {
                            <span class="selected-count">Selected @(reviewIndex + 1) of @selectedResults.Count</span>
                            <button type="button" class="icon-button bordered" disabled="@(reviewIndex == 0)" @onclick="PreviousSelected" aria-label="Previous selected result">&lt;</button>
                            <button type="button" class="icon-button bordered" disabled="@(reviewIndex >= selectedResults.Count - 1)" @onclick="NextSelected" aria-label="Next selected result">&gt;</button>
                        }
                        <button type="button" class="secondary-button" @onclick="() => ToggleResult(previewResult.Id)">
                            @(selectedResultIds.Contains(previewResult.Id) ? "Remove from Selected Context" : "Add to Selected Context")
                        </button>
                        <button type="button" class="secondary-button" @onclick="() => ShowInList(previewResult)">Show in List</button>
                    </div>
                </header>

                <div class="preview-body">
                    @if (!previewResult.IsPreviewAvailable)
                    {
                        <div class="bulk-empty-state preview-empty">
                            <strong>This analysis result is not available for preview.</strong>
                            <span>It can still be selected or removed from context.</span>
                        </div>
                    }
                    else
                    {
                        <article class="markdown-preview">
                            @RenderMarkdown(previewResult)
                        </article>
                    }
                </div>
            }
        </section>
    </section>
</section>

@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private IReadOnlyList<BulkAnalysisFolder> allFolders = [];
    private readonly HashSet<string> selectedFilterFolderIds = new(StringComparer.Ordinal);
    private readonly HashSet<string> selectedResultIds = new(StringComparer.Ordinal);
    private string searchTerm = string.Empty;
    private string analysisTypeFilter = string.Empty;
    private string sortMode = "recent";
    private string? focusedResultId;
    private string? selectionWarning;
    private bool isFilterPanelExpanded = true;
    private bool isReviewMode;
    private int reviewIndex;

    private IReadOnlyList<BulkAnalysisFolder> AllFolders => allFolders;

    private IReadOnlyList<BulkAnalysisResult> AllResults =>
        allFolders.SelectMany(folder => folder.Sops).SelectMany(sop => sop.Results).ToArray();

    private IReadOnlyList<string> AnalysisTypes =>
        AllResults.Select(result => result.AnalysisType)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private bool HasDirtyLoadedContext
    {
        get
        {
            if (!ChatContext.HasLoadedContext)
            {
                return false;
            }

            var loadedIds = ChatContext.LoadedItems
                .Select(item => item.ResultId)
                .ToHashSet(StringComparer.Ordinal);

            return !loadedIds.SetEquals(selectedResultIds);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ChatContext.Changed += HandleChatContextChanged;
        await RefreshAsync();

        if (ChatContext.HasLoadedContext)
        {
            foreach (var item in ChatContext.LoadedItems)
            {
                selectedResultIds.Add(item.ResultId);
            }
        }
    }

    private async Task RefreshAsync()
    {
        allFolders = await ResultProvider.GetFoldersAsync();

        if (focusedResultId is not null && AllResults.All(result => result.Id != focusedResultId))
        {
            focusedResultId = null;
        }
    }

    private void ToggleFilters()
    {
        isFilterPanelExpanded = !isFilterPanelExpanded;
    }

    private void HandleSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
    }

    private void HandleAnalysisTypeChange(ChangeEventArgs args)
    {
        analysisTypeFilter = args.Value?.ToString() ?? string.Empty;
    }

    private void HandleSortChange(ChangeEventArgs args)
    {
        sortMode = args.Value?.ToString() ?? "recent";
    }

    private void ToggleFolderFilter(string folderId)
    {
        if (!selectedFilterFolderIds.Add(folderId))
        {
            selectedFilterFolderIds.Remove(folderId);
        }
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        analysisTypeFilter = string.Empty;
        sortMode = "recent";
        selectedFilterFolderIds.Clear();
    }

    private IReadOnlyList<DisplayFolder> GetFilteredGroups()
    {
        var folderGroups = new List<DisplayFolder>();

        foreach (var folder in AllFolders)
        {
            if (selectedFilterFolderIds.Count > 0 && !selectedFilterFolderIds.Contains(folder.Id))
            {
                continue;
            }

            var sopGroups = new List<DisplaySop>();

            foreach (var sop in SortSops(folder.Sops))
            {
                var results = SortResults(sop.Results)
                    .Where(result => MatchesAnalysisType(result) && MatchesSearch(folder, sop, result))
                    .ToArray();

                if (results.Length > 0)
                {
                    sopGroups.Add(new DisplaySop(sop, results));
                }
            }

            if (sopGroups.Count > 0)
            {
                folderGroups.Add(new DisplayFolder(folder, sopGroups));
            }
        }

        return sortMode switch
        {
            "folder" => folderGroups.OrderBy(group => group.Folder.DisplayName, StringComparer.OrdinalIgnoreCase).ToArray(),
            "sop" => folderGroups.OrderBy(group => group.Sops.First().Sop.Title, StringComparer.OrdinalIgnoreCase).ToArray(),
            "analysis" => folderGroups.OrderBy(group => group.Results.First().AnalysisType, StringComparer.OrdinalIgnoreCase).ToArray(),
            _ => folderGroups.OrderByDescending(group => group.Results.Max(result => result.GeneratedAt)).ToArray()
        };
    }

    private IEnumerable<BulkAnalysisSop> SortSops(IEnumerable<BulkAnalysisSop> sops) =>
        sortMode == "sop"
            ? sops.OrderBy(sop => sop.Title, StringComparer.OrdinalIgnoreCase)
            : sops;

    private IEnumerable<BulkAnalysisResult> SortResults(IEnumerable<BulkAnalysisResult> results) =>
        sortMode switch
        {
            "analysis" => results.OrderBy(result => result.AnalysisType, StringComparer.OrdinalIgnoreCase),
            "sop" => results.OrderBy(result => result.SopTitle, StringComparer.OrdinalIgnoreCase),
            _ => results.OrderByDescending(result => result.GeneratedAt)
        };

    private bool MatchesAnalysisType(BulkAnalysisResult result) =>
        string.IsNullOrWhiteSpace(analysisTypeFilter) ||
        string.Equals(result.AnalysisType, analysisTypeFilter, StringComparison.OrdinalIgnoreCase);

    private bool MatchesSearch(BulkAnalysisFolder folder, BulkAnalysisSop sop, BulkAnalysisResult result)
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            return true;
        }

        return Contains(folder.DisplayName, searchTerm) ||
            Contains(folder.ParentDisplayName, searchTerm) ||
            Contains(sop.Title, searchTerm) ||
            Contains(sop.OriginalFileName, searchTerm) ||
            Contains(result.AnalysisType, searchTerm) ||
            Contains(result.OriginalFileName, searchTerm);
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<BulkAnalysisResult> GetSelectedResults() =>
        AllResults
            .Where(result => selectedResultIds.Contains(result.Id))
            .OrderBy(result => result.FolderName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(result => result.SopTitle, StringComparer.OrdinalIgnoreCase)
            .ThenBy(result => result.AnalysisType, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private BulkAnalysisResult? GetPreviewResult()
    {
        var selectedResults = GetSelectedResults();

        if (isReviewMode && selectedResults.Count > 0)
        {
            reviewIndex = Math.Clamp(reviewIndex, 0, selectedResults.Count - 1);
            focusedResultId = selectedResults[reviewIndex].Id;
            return selectedResults[reviewIndex];
        }

        return focusedResultId is null
            ? null
            : AllResults.FirstOrDefault(result => result.Id == focusedResultId);
    }

    private SelectionState GetSelectionState(IEnumerable<string> ids)
    {
        var resultIds = ids.ToArray();

        if (resultIds.Length == 0 || resultIds.All(id => !selectedResultIds.Contains(id)))
        {
            return SelectionState.Unchecked;
        }

        return resultIds.All(selectedResultIds.Contains)
            ? SelectionState.Checked
            : SelectionState.Mixed;
    }

    private string GetTriStateClass(SelectionState state) =>
        state switch
        {
            SelectionState.Checked => "tri-checkbox checked",
            SelectionState.Mixed => "tri-checkbox mixed",
            _ => "tri-checkbox"
        };

    private string GetAriaChecked(SelectionState state) =>
        state switch
        {
            SelectionState.Checked => "true",
            SelectionState.Mixed => "mixed",
            _ => "false"
        };

    private bool WouldGroupSelectionExceedLimit(IEnumerable<BulkAnalysisResult> results)
    {
        var selectedTokens = GetSelectedResults().Sum(result => result.EstimatedTokens);
        var additionalTokens = results
            .Where(result => !selectedResultIds.Contains(result.Id))
            .Sum(result => result.EstimatedTokens);

        return selectedTokens + additionalTokens > ChatContextState.ContextLimitTokens;
    }

    private void ToggleFolder(DisplayFolder folder)
    {
        ToggleResultGroup(folder.Results, "Selecting this folder would exceed the context limit. Narrow the filters or select fewer results.");
    }

    private void ToggleSop(DisplaySop sop)
    {
        ToggleResultGroup(sop.Results, "Selecting this SOP would exceed the context limit. Narrow the filters or select fewer results.");
    }

    private void ToggleResultGroup(IReadOnlyList<BulkAnalysisResult> results, string warning)
    {
        selectionWarning = null;
        var state = GetSelectionState(results.Select(result => result.Id));

        if (state == SelectionState.Checked)
        {
            foreach (var result in results)
            {
                selectedResultIds.Remove(result.Id);
            }

            SyncReviewAfterSelectionChange();
            return;
        }

        if (WouldGroupSelectionExceedLimit(results))
        {
            selectionWarning = warning;
            return;
        }

        foreach (var result in results)
        {
            selectedResultIds.Add(result.Id);
        }

        SyncReviewAfterSelectionChange();
    }

    private void ToggleResult(string resultId)
    {
        selectionWarning = null;

        if (!selectedResultIds.Add(resultId))
        {
            selectedResultIds.Remove(resultId);
        }

        if (focusedResultId is null)
        {
            focusedResultId = resultId;
        }

        SyncReviewAfterSelectionChange();
    }

    private void PreviewResult(BulkAnalysisResult result)
    {
        isReviewMode = false;
        focusedResultId = result.Id;
    }

    private void ReviewSelected()
    {
        var selectedResults = GetSelectedResults();

        if (selectedResults.Count == 0)
        {
            return;
        }

        isReviewMode = true;
        reviewIndex = 0;
        focusedResultId = selectedResults[0].Id;
    }

    private void PreviousSelected()
    {
        if (!isReviewMode || reviewIndex <= 0)
        {
            return;
        }

        reviewIndex--;
        focusedResultId = GetSelectedResults()[reviewIndex].Id;
    }

    private void NextSelected()
    {
        var selectedResults = GetSelectedResults();

        if (!isReviewMode || reviewIndex >= selectedResults.Count - 1)
        {
            return;
        }

        reviewIndex++;
        focusedResultId = selectedResults[reviewIndex].Id;
    }

    private void RemoveSelected(string resultId)
    {
        selectedResultIds.Remove(resultId);
        SyncReviewAfterSelectionChange();
    }

    private void ClearSelection()
    {
        selectedResultIds.Clear();
        isReviewMode = false;
        focusedResultId = null;
        reviewIndex = 0;
        selectionWarning = null;
    }

    private void LoadContext()
    {
        var selectedResults = GetSelectedResults();

        if (selectedResults.Count == 0 ||
            selectedResults.Sum(result => result.EstimatedTokens) > ChatContextState.ContextLimitTokens)
        {
            return;
        }

        ChatContext.Load(selectedResults);
        selectionWarning = null;
    }

    private void GoToChat()
    {
        NavigationManager.NavigateTo("/");
    }

    private void ClearLoadedContext()
    {
        ChatContext.Clear();
    }

    private void ShowInList(BulkAnalysisResult result)
    {
        searchTerm = string.Empty;
        analysisTypeFilter = string.Empty;
        selectedFilterFolderIds.Clear();
        selectedFilterFolderIds.Add(result.FolderId);
        isFilterPanelExpanded = false;
        focusedResultId = result.Id;
        isReviewMode = false;
    }

    private void SyncReviewAfterSelectionChange()
    {
        var selectedResults = GetSelectedResults();

        if (selectedResults.Count == 0)
        {
            isReviewMode = false;
            reviewIndex = 0;
            return;
        }

        if (isReviewMode)
        {
            reviewIndex = Math.Clamp(reviewIndex, 0, selectedResults.Count - 1);
            focusedResultId = selectedResults[reviewIndex].Id;
        }
    }

    private IReadOnlyList<string> GetActiveFilterChips()
    {
        var chips = new List<string>();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            chips.Add($"Search: {searchTerm}");
        }

        chips.AddRange(AllFolders
            .Where(folder => selectedFilterFolderIds.Contains(folder.Id))
            .Select(folder => folder.DisplayName));

        if (!string.IsNullOrWhiteSpace(analysisTypeFilter))
        {
            chips.Add(analysisTypeFilter);
        }

        if (!string.Equals(sortMode, "recent", StringComparison.OrdinalIgnoreCase))
        {
            chips.Add(sortMode switch
            {
                "sop" => "SOP name",
                "folder" => "Folder sort",
                "analysis" => "Analysis type sort",
                _ => sortMode
            });
        }

        return chips;
    }

    private string GetResultRowClass(BulkAnalysisResult result)
    {
        var classes = new List<string> { "bulk-result-row" };

        if (selectedResultIds.Contains(result.Id))
        {
            classes.Add("selected");
        }

        if (string.Equals(focusedResultId, result.Id, StringComparison.Ordinal))
        {
            classes.Add("focused");
        }

        return string.Join(' ', classes);
    }

    private MarkupString RenderMarkdown(BulkAnalysisResult result) =>
        new(Markdown.ToHtml(result.Markdown, MarkdownPipeline));

    private static string FormatTokens(int tokens) =>
        tokens >= 1_000 ? $"{tokens / 1_000.0:0.#}k" : tokens.ToString("N0");

    private static string FormatPercent(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private void HandleChatContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatContext.Changed -= HandleChatContextChanged;
    }

    private sealed record DisplayFolder(BulkAnalysisFolder Folder, IReadOnlyList<DisplaySop> Sops)
    {
        public IReadOnlyList<BulkAnalysisResult> Results => Sops.SelectMany(sop => sop.Results).ToArray();
    }

    private sealed record DisplaySop(BulkAnalysisSop Sop, IReadOnlyList<BulkAnalysisResult> Results);

    private enum SelectionState
    {
        Unchecked,
        Mixed,
        Checked
    }
}
