{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build file-manager-api",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\file-manager-api\\file-manager-api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build file-manager-blazor",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\file-manager-blazor\\FileManagerBlazor.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "stop existing file-manager-blazor instances",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-Command",
        "$ports = @(5167, 7016); $processIds = @(); foreach ($port in $ports) { $processIds += Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess }; $processIds += Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'dotnet.exe' -and $_.CommandLine -match 'FileManagerBlazor|file-manager-blazor|blazor-devserver' } | Select-Object -ExpandProperty ProcessId; $processIds | Where-Object { $_ -and $_ -ne $PID } | Sort-Object -Unique | ForEach-Object { Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue }"
      ],
      "problemMatcher": []
    },
    {
      "label": "run file-manager-blazor",
      "type": "shell",
      "command": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}\\file-manager-blazor\\FileManagerBlazor.csproj",
        "--launch-profile",
        "http"
      ],
      "dependsOn": [
        "stop existing file-manager-blazor instances"
      ],
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "blazor",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Determining projects to restore",
          "endsPattern": "Now listening on:"
        }
      }
    }
  ]
}
