    private async Task RenderSelectedSourcePreviewAsync()
    {
        var previewDocument = workflowStep == WorkflowStep.SelectDocuments
            ? GetSelectionPreviewDocument(GetSelectedDocuments())
            : null;
        var previewDocumentId = previewDocument?.Document.Id;

        if (string.Equals(previewDocumentId, renderedSourcePreviewDocumentId, StringComparison.Ordinal))
        {
            return;
        }

        renderedSourcePreviewDocumentId = previewDocumentId;
        rawPreviewError = null;

        if (previewDocumentId is null)
        {
            return;
        }

        try
        {
            var rawFile = await ResultProvider.GetRawFileAsync(previewDocumentId);
            if (rawFile is null)
            {
                rawPreviewError = "The selected raw file could not be found in the provider catalog.";
                await JSRuntime.InvokeVoidAsync("bulkAnalysisPreview.clear", sourcePreviewHost);
                StateHasChanged();
                return;
            }

            await JSRuntime.InvokeVoidAsync(
                "bulkAnalysisPreview.render",
                sourcePreviewHost,
                rawFile.FileName,
                rawFile.ContentType,
                rawFile.Content);
        }
        catch (Exception ex)
        {
            rawPreviewError = ex.Message;
            await JSRuntime.InvokeVoidAsync("bulkAnalysisPreview.clear", sourcePreviewHost);
            StateHasChanged();
        }
    }

    private BulkAnalysisResultPreview? GetResultPreview(BulkAnalysisResult result) =>
        resultPreviewById.GetValueOrDefault(result.Id);

    private string? GetResultPreviewError(BulkAnalysisResult result) =>
        resultPreviewErrorsById.GetValueOrDefault(result.Id);

    private async Task<BulkAnalysisResultFile> GetOrLoadResultFileAsync(BulkAnalysisResult result) =>
        await ResultProvider.GetResultFileAsync(result.Id)
            ?? throw new InvalidOperationException($"The selected {result.AnalysisType} result file could not be found in ADLS.");

    private async Task<BulkAnalysisResultPreview> GetOrLoadResultPreviewAsync(BulkAnalysisResult result)
    {
        var existingPreview = GetResultPreview(result);
        if (existingPreview is not null)
        {
            return existingPreview;
        }

        var preview = ShouldRenderResultFileNatively(result)
            ? await BuildNativeResultPreviewAsync(result)
            : await ResultProvider.GetResultPreviewAsync(result.Id)
                ?? throw new InvalidOperationException($"The selected {result.AnalysisType} preview could not be found in ADLS.");

        resultPreviewById[result.Id] = preview;
        resultPreviewErrorsById.Remove(result.Id);
        return preview;
    }

    private async Task<BulkAnalysisResultPreview> BuildNativeResultPreviewAsync(BulkAnalysisResult result)
    {
        var resultFile = await GetOrLoadResultFileAsync(result);
        return new BulkAnalysisResultPreview(
            result.Id,
            resultFile.FileName,
            resultFile.ContentType,
            NormalizeFileExtension(resultFile.FileExtension),
            GetResultFormatLabel(result),
            resultFile.Content);
    }

    private async Task LoadActiveResultPreviewAsync()
    {
        if (workflowStep != WorkflowStep.Results)
        {
            return;
        }

        var selectedDocuments = GetSelectedDocuments();
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(selectedDocuments));
        var activeDocument = GetActiveDocument(selectedDocuments);
        var activeAnalysisType = GetActiveAnalysisType(selectedAnalysisTypes);
        var activeResult = activeDocument is null || activeAnalysisType is null
            ? null
            : activeDocument.Document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase));

        if (activeResult is null ||
            !activeResult.IsPreviewAvailable ||
            GetResultPreview(activeResult) is not null ||
            resultPreviewErrorsById.ContainsKey(activeResult.Id) ||
            string.Equals(loadingResultPreviewId, activeResult.Id, StringComparison.Ordinal))
        {
            return;
        }

        loadingResultPreviewId = activeResult.Id;
        await InvokeAsync(StateHasChanged);

        try
        {
            await GetOrLoadResultPreviewAsync(activeResult);
        }
        catch (Exception ex)
        {
            resultPreviewErrorsById[activeResult.Id] = ex.Message;
        }
        finally
        {
            if (string.Equals(loadingResultPreviewId, activeResult.Id, StringComparison.Ordinal))
            {
                loadingResultPreviewId = null;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RenderActiveResultNativePreviewAsync()
    {
        if (workflowStep != WorkflowStep.Results)
        {
            renderedResultPreviewId = null;
            return;
        }

        var selectedDocuments = GetSelectedDocuments();
        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(selectedDocuments));
        var activeDocument = GetActiveDocument(selectedDocuments);
        var activeAnalysisType = GetActiveAnalysisType(selectedAnalysisTypes);
        var activeResult = activeDocument is null || activeAnalysisType is null
            ? null
            : activeDocument.Document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, activeAnalysisType, StringComparison.OrdinalIgnoreCase));
        var preview = activeResult is null ? null : GetResultPreview(activeResult);

        if (activeResult is null || preview is null || !IsNativePreview(preview))
        {
            if (renderedResultPreviewId is not null)
            {
                renderedResultPreviewId = null;
                await JSRuntime.InvokeVoidAsync("bulkAnalysisPreview.clear", resultPreviewHost);
            }

            return;
        }

        if (string.Equals(renderedResultPreviewId, activeResult.Id, StringComparison.Ordinal))
        {
            return;
        }

        renderedResultPreviewId = activeResult.Id;
        await JSRuntime.InvokeVoidAsync(
            "bulkAnalysisPreview.render",
            resultPreviewHost,
            preview.FileName,
            preview.ContentType,
            preview.Content);
    }

    private static MarkupString RenderMarkdown(string markdown) =>
        new(Markdown.ToHtml(markdown, MarkdownPipeline));

    private static string? GetResultPreviewText(BulkAnalysisResultPreview preview) =>
        IsTextPreview(preview) ? Encoding.UTF8.GetString(preview.Content) : null;

    private static string GetFolderPath(BulkAnalysisFolder folder) =>
        string.IsNullOrWhiteSpace(folder.ParentDisplayName)
            ? folder.DisplayName
            : $"{folder.ParentDisplayName} / {folder.DisplayName}";

    private static string GetResultFormatLabel(BulkAnalysisResult result) =>
        (result.ResultExtension ?? string.Empty).ToLowerInvariant() switch
        {
            "doc" or "docx" => "Word",
            "htm" or "html" => "HTML",
            "md" => "Markdown",
            "pdf" => "PDF",
            "txt" => "Plain Text",
            _ => "Binary"
        };

    private static bool IsMarkdownPreview(BulkAnalysisResultPreview preview) =>
        string.Equals(preview.FileExtension, "md", StringComparison.OrdinalIgnoreCase);

    private static bool IsPlainTextPreview(BulkAnalysisResultPreview preview) =>
        string.Equals(preview.FileExtension, "txt", StringComparison.OrdinalIgnoreCase);

    private static bool IsTextPreview(BulkAnalysisResultPreview preview) =>
        IsMarkdownPreview(preview) || IsPlainTextPreview(preview);

    private static bool IsNativePreview(BulkAnalysisResultPreview preview) => !IsTextPreview(preview);

    private static bool ShouldRenderResultFileNatively(BulkAnalysisResult result) =>
        NormalizeFileExtension(result.ResultExtension) is "docx" or "pdf";

    private static string NormalizeFileExtension(string? extension) =>
        extension?.TrimStart('.').ToLowerInvariant() ?? string.Empty;

    private static int EstimateTokens(string markdown) =>
        (int)Math.Ceiling(markdown.Length / 4.0);

    private static string FormatTokens(int tokens) =>
        tokens >= 1_000 ? $"{tokens / 1_000.0:0.#}k" : tokens.ToString("N0");

    private sealed record DocumentWithFolder(BulkAnalysisFolder Folder, BulkAnalysisDocument Document);

    private sealed record ResultAnalysisPanel(
        string NodeId,
        string AnalysisType,
        IReadOnlyList<ResultCategoryPanel> Categories)
    {
        public IReadOnlyList<ResultFileItem> Items =>
            Categories.SelectMany(category => category.Items).ToArray();

        public IReadOnlyList<BulkAnalysisResult> Results =>
            Items.Select(item => item.Result).ToArray();
    }

    private sealed record ResultCategoryPanel(
        string NodeId,
        BulkAnalysisFolder Folder,
        IReadOnlyList<ResultFileItem> Items,
        int Depth)
    {
        public IReadOnlyList<BulkAnalysisResult> Results =>
            Items.Select(item => item.Result).ToArray();
    }

    private sealed record ResultFileItem(
        BulkAnalysisFolder Folder,
        BulkAnalysisDocument Document,
        BulkAnalysisResult Result);

    private sealed record DocumentFolderPanel(
        BulkAnalysisFolder Folder,
        IReadOnlyList<BulkAnalysisDocument> Documents,
        IReadOnlyList<DocumentFolderPanel> Children,
        int Depth)
    {
        public int VisibleDocumentCount => Documents.Count + Children.Sum(child => child.VisibleDocumentCount);

        public IReadOnlyList<BulkAnalysisDocument> VisibleDocuments =>
            Documents.Concat(Children.SelectMany(child => child.VisibleDocuments)).ToArray();
    }

    private enum WorkflowStep
    {
        SelectDocuments,
        SelectAnalysisTypes,
        Results
    }

    private enum SelectionState
    {
        Unchecked,
        Mixed,
        Checked
    }
