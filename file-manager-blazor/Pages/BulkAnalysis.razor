    private IReadOnlyList<ResultAnalysisPanel> GetVisibleResultAnalysisPanels(
        IReadOnlyList<DocumentWithFolder> selectedDocuments,
        IReadOnlyList<string> selectedAnalysisTypes)
    {
        var panels = new List<ResultAnalysisPanel>();

        foreach (var analysisType in selectedAnalysisTypes)
        {
            var items = selectedDocuments
                .Select(entry => new
                {
                    entry.Folder,
                    entry.Document,
                    Result = GetResult(entry.Document, analysisType)
                })
                .Where(entry => entry.Result is not null)
                .Select(entry => new ResultFileItem(entry.Folder, entry.Document, entry.Result!))
                .ToArray();

            if (items.Length == 0)
            {
                continue;
            }

            var categories = items
                .GroupBy(item => item.Folder.Id)
                .OrderBy(group => group.First().Folder.DisplayName, StringComparer.OrdinalIgnoreCase)
                .Select(group => new ResultCategoryPanel(
                    GetResultCategoryNodeId(analysisType, group.First().Folder.Id),
                    group.First().Folder,
                    group
                        .OrderBy(item => item.Document.OriginalFileName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(item => item.Document.Title, StringComparer.OrdinalIgnoreCase)
                        .ToArray(),
                    Depth: 1))
                .ToArray();

            panels.Add(new ResultAnalysisPanel(GetResultAnalysisNodeId(analysisType), analysisType, categories));
        }

        return panels;
    }

