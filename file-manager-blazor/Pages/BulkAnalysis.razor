    private sealed record DocumentFolderPanel(
        BulkAnalysisFolder Folder,
        IReadOnlyList<BulkAnalysisDocument> Documents,
        IReadOnlyList<DocumentFolderPanel> Children,
        int Depth)
    {
        public int VisibleDocumentCount => Documents.Count + Children.Sum(child => child.VisibleDocumentCount);

        public IReadOnlyList<BulkAnalysisDocument> VisibleDocuments =>
            Documents.Concat(Children.SelectMany(child => child.VisibleDocuments)).ToArray();
    }

