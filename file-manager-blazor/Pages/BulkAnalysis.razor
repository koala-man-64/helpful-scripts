    private IReadOnlyList<string> GetAvailableAnalysisTypes(IReadOnlyList<DocumentWithFolder> selectedDocuments) =>
        selectedDocuments
            .SelectMany(entry => entry.Document.Results)
            .Select(result => result.AnalysisType)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<string> GetSelectedAnalysisTypes(IReadOnlyList<string> availableAnalysisTypes) =>
        availableAnalysisTypes
            .Where(selectedAnalysisTypeIds.Contains)
            .OrderBy(type => type, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private DocumentWithFolder? GetActiveDocument(IReadOnlyList<DocumentWithFolder> selectedDocuments) =>
        selectedDocuments.FirstOrDefault(entry => string.Equals(entry.Document.Id, activeDocumentId, StringComparison.Ordinal)) ??
        selectedDocuments.FirstOrDefault();

    private string? GetActiveAnalysisType(IReadOnlyList<string> selectedAnalysisTypes) =>
        selectedAnalysisTypes.FirstOrDefault(type => string.Equals(type, activeAnalysisType, StringComparison.OrdinalIgnoreCase)) ??
        selectedAnalysisTypes.FirstOrDefault();

    private static BulkAnalysisResult? GetResult(BulkAnalysisDocument document, string analysisType) =>
        document.Results.FirstOrDefault(result => string.Equals(result.AnalysisType, analysisType, StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<BulkAnalysisResult> GetAvailableResults(
        BulkAnalysisDocument document,
        IReadOnlyList<string> selectedAnalysisTypes) =>
        selectedAnalysisTypes
            .Select(type => GetResult(document, type))
            .Where(result => result is not null)
            .Select(result => result!)
            .ToArray();

    private static string GetResultAvailabilitySummary(BulkAnalysisDocument document, IReadOnlyList<string> selectedAnalysisTypes)
    {
        var availableCount = GetAvailableResults(document, selectedAnalysisTypes).Count;

        return availableCount == 0
            ? "No selected result types available"
            : $"{availableCount} of {selectedAnalysisTypes.Count} selected result type{(selectedAnalysisTypes.Count == 1 ? "" : "s")} available";
    }

    private void SetActiveDocument(string documentId)
    {
        activeDocumentId = documentId;

        var selectedAnalysisTypes = GetSelectedAnalysisTypes(GetAvailableAnalysisTypes(GetSelectedDocuments()));
        var activeDocument = GetSelectedDocuments().FirstOrDefault(entry => string.Equals(entry.Document.Id, documentId, StringComparison.Ordinal));

        if (activeDocument is not null &&
            (activeAnalysisType is null || GetResult(activeDocument.Document, activeAnalysisType) is null))
        {
            activeAnalysisType =
                selectedAnalysisTypes.FirstOrDefault(type => GetResult(activeDocument.Document, type) is not null) ??
                selectedAnalysisTypes.FirstOrDefault();
        }
    }

    private void SetActiveResult(string documentId, string analysisType)
    {
        activeDocumentId = documentId;
        activeAnalysisType = analysisType;
    }

    private SelectionState GetResultSelectionState(
        IEnumerable<BulkAnalysisDocument> documents,
        IReadOnlyList<string> selectedAnalysisTypes)
    {
        var results = documents
            .SelectMany(document => GetAvailableResults(document, selectedAnalysisTypes))
            .ToArray();

        if (results.Length == 0 || results.All(result => !selectedContextIds.Contains(result.Id)))
        {
            return SelectionState.Unchecked;
        }

        return results.All(result => selectedContextIds.Contains(result.Id))
            ? SelectionState.Checked
            : SelectionState.Mixed;
    }

    private SelectionState GetResultSelectionState(
        BulkAnalysisDocument document,
        IReadOnlyList<string> selectedAnalysisTypes) =>
        GetResultSelectionState(new[] { document }, selectedAnalysisTypes);

