{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rudy.local/codex-workflow-hooks/repository-overlay-v1.schema.json",
  "title": "Codex workflow hook repository overlay",
  "description": "Additive repository identity and validation requirements. Authority and safety rules are intentionally absent so an overlay cannot weaken the global policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository_id",
    "name",
    "canonical_origin",
    "azure",
    "protected_branches",
    "validation_profiles",
    "required_validation"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_origin": {
      "type": "string",
      "pattern": "^azure://[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "project",
        "repository_id",
        "remote_url"
      ],
      "properties": {
        "organization": {
          "const": "https://dev.azure.com/rdprokes"
        },
        "project": {
          "const": "AdaptiveAssetAllocation"
        },
        "repository_id": {
          "type": "string",
          "format": "uuid"
        },
        "remote_url": {
          "type": "string",
          "pattern": "^https://dev\\.azure\\.com/rdprokes/AdaptiveAssetAllocation/_git/[a-z0-9-]+$"
        }
      }
    },
    "protected_branches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationProfile"
      }
    },
    "required_validation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "delivery_verification": {
      "$ref": "#/$defs/deliveryVerification"
    }
  },
  "$defs": {
    "validationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "working_directory",
        "commands",
        "evidence_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "path_globs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_state": {
          "const": "validated"
        }
      }
    },
    "deliveryVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_targets"
      ],
      "properties": {
        "https_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/httpsTarget"
          }
        }
      }
    },
    "httpsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "states",
        "expected_status",
        "commit_header"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^@#]+$"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime_healthy",
              "user_path_verified"
            ]
          }
        },
        "expected_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "commit_header": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        },
        "content_type_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "states": {
                "contains": {
                  "const": "user_path_verified"
                }
              }
            }
          },
          "then": {
            "required": [
              "body_sha256"
            ]
          }
        }
      ]
    }
  }
}
