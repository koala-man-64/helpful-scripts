            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray()).Trim('-');

        return $"analysis-description-{(string.IsNullOrWhiteSpace(normalized) ? "type" : normalized)}";
    }

    private static string GetFolderDescriptionId(string folderId)
    {
        var normalized = new string(folderId
            .Select(character => char.IsLetterOrDigit(character) ? char.ToLowerInvariant(character) : '-')
            .ToArray()).Trim('-');

        return $"folder-description-{(string.IsNullOrWhiteSpace(normalized) ? "category" : normalized)}";
    }

